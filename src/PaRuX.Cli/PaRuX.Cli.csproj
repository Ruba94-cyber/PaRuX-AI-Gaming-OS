<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PaRuX.Cli</RootNamespace>
    <AssemblyName>parux</AssemblyName>
    <Version>$(PaRuXProductVersion)</Version>
    <FileVersion>$(PaRuXProductVersion).0</FileVersion>
    <AssemblyVersion>$(PaRuXProductVersion).0</AssemblyVersion>
    <InformationalVersion>$(PaRuXProductVersion)</InformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaRuX.Contracts\PaRuX.Contracts.csproj" />
  </ItemGroup>

</Project>
