<?xml version="1.0" encoding="utf-8"?>
<!--
    PaRuX design system
    ====================
    One place for every colour, size, radius and text style PaRuX uses.

    Structure
      1. ThemeDictionaries  - Light / Dark / HighContrast colour tokens.
                              Consume these with {ThemeResource ...} so the
                              Settings theme switch actually repaints.
      2. Scale tokens       - spacing, radii, type ramp, font families.
                              (The monospace family is NOT here: it is hardcoded in
                              Services\MarkdownRenderer.cs, which this pass was not
                              allowed to touch.)
                              Theme-independent, so they live outside the
                              theme dictionaries. Consume with {StaticResource ...}.
      3. Component styles   - Border / TextBlock / Grid only.
                              Deliberately no Control styles: an explicit Style
                              on a templated control without a verified BasedOn
                              key is the one thing that can silently blank a
                              control at runtime, and this tree has never been
                              compiled. Buttons therefore carry token values
                              inline and get their hover/pressed states from the
                              WinUI theme-resource overrides below.

    The five style keys the C# looks up by name
    (PaRuXUserBubbleStyle, PaRuXAssistantBubbleStyle, PaRuXErrorBubbleStyle,
     PaRuXCodeBlockStyle, PaRuXSubtleCaptionStyle) intentionally stay in
    App.xaml's own dictionary, NOT here, because ChatView / MarkdownRenderer
    reach them via Application.Current.Resources.TryGetValue and merged-dictionary
    traversal for that API is not worth betting the app on.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

