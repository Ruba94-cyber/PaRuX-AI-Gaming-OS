<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaRuX.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PaRuX.Views"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="Settings_Page"
    AutomationProperties.Name="Settings" loc:Loc.ItName="Impostazioni"
    AutomationProperties.AccessibilityView="Raw"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <!-- Diagnostics health dot, coloured from the code-behind by key. -->
        <SolidColorBrush x:Key="PaRuXDotOkBrush" Color="{ThemeResource PaRuXSuccessColor}" />
        <SolidColorBrush x:Key="PaRuXDotWarnBrush" Color="{ThemeResource PaRuXWarnColor}" />
        <SolidColorBrush x:Key="PaRuXDotOffBrush" Color="{ThemeResource PaRuXOffColor}" />
    </UserControl.Resources>

    <Grid x:Name="SettingsLayoutGrid" Background="{ThemeResource PaRuXSurfaceAppBrush}" SizeChanged="SettingsLayoutGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsRailColumn" Width="192" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Category rail ==================== -->
        <ScrollViewer x:Name="SettingsRailScroll" Grid.Column="0" Grid.Row="1"
                      Background="{ThemeResource PaRuXGrapheneSidebarBrush}"
                      BorderBrush="{ThemeResource PaRuXStrokeBrush}" BorderThickness="0,0,1,0"
                      VerticalScrollBarVisibility="Auto" Padding="12,20,8,20">
            <StackPanel x:Name="SettingsCategoryRail" Spacing="2" />
        </ScrollViewer>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,8,12,4" Spacing="6">
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="Settings_Search_Box"
                            AutomationProperties.Name="Find a setting" loc:Loc.ItName="Trova un&#x27;impostazione"
                            PlaceholderText="Find a setting, e.g. GPU, microphone, privacy…" loc:Loc.ItPlaceholder="Trova un&#x27;impostazione, ad es. GPU, microfono, privacy…"
                            QueryIcon="Find"
                            TextChanged="SettingsSearchBox_TextChanged"
                            QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                            SuggestionChosen="SettingsSearchBox_SuggestionChosen" />
            <TextBlock x:Name="SettingsSearchFeedback"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Style="{StaticResource PaRuXCaptionTextStyle}"
                       AutomationProperties.AutomationId="Settings_Search_Feedback" />
            <ComboBox x:Name="SettingsCompactCategoryPicker"
                      Visibility="Collapsed" HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="Settings_CompactCategory_ComboBox"
                      AutomationProperties.Name="Settings category" loc:Loc.ItName="Categoria delle impostazioni"
                      SelectionChanged="SettingsCompactCategoryPicker_SelectionChanged" />
        </StackPanel>

        <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,32">
        <StackPanel x:Name="SettingsContentPanel" Spacing="{StaticResource PaRuXSpaceXL}" MaxWidth="760" HorizontalAlignment="Left">

            <!-- ==================== Page header ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceXS}">
                <TextBlock Text="Settings" loc:Loc.ItText="Impostazioni" Style="{StaticResource PaRuXDisplayTextStyle}" />
                <TextBlock
                    Text="How PaRuX looks, when it appears, and what it runs on." loc:Loc.ItText="Aspetto di PaRuX, quando compare e su cosa viene eseguito."
                    Style="{StaticResource PaRuXCaptionTextStyle}" />
            </StackPanel>

            <!-- ==================== General ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="General">
                <TextBlock Text="GENERAL" loc:Loc.ItText="GENERALE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Theme" loc:Loc.ItText="Tema" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock
                                    Text="Follow Windows, or pin PaRuX to light or dark." loc:Loc.ItText="Segui Windows oppure fissa PaRuX su chiaro o scuro."
                                    Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" AutomationProperties.AutomationId="Settings_Theme_ComboBox" AutomationProperties.Name="Theme" loc:Loc.ItName="Tema" AutomationProperties.AccessibilityView="Control" Grid.Column="1" MinWidth="160"
                                      VerticalAlignment="Center"
                                      CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="System" loc:Loc.ItContent="Sistema" Tag="System" />
                                <ComboBoxItem Content="Light" loc:Loc.ItContent="Chiaro" Tag="Light" />
                                <ComboBoxItem Content="Dark" loc:Loc.ItContent="Scuro" Tag="Dark" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Language" loc:Loc.ItText="Lingua" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="LanguageHint"
                                    Text="English is the default. Italian is available as an alternative." loc:Loc.ItText="L&#x27;inglese è la lingua predefinita. L&#x27;italiano è disponibile in alternativa."
                                    Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" AutomationProperties.AutomationId="Settings_Language_ComboBox" AutomationProperties.Name="Language" loc:Loc.ItName="Lingua"
                                      Grid.Column="1" VerticalAlignment="Center"
                                      CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                      SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Italiano" Tag="it" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Start with Windows" loc:Loc.ItText="Avvia con Windows" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="StartupHint"
                                           Text="Adds PaRuX to the Windows startup list." loc:Loc.ItText="Aggiunge PaRuX all&#x27;elenco di avvio di Windows."
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" AutomationProperties.AutomationId="Settings_Startup_Toggle" AutomationProperties.Name="Start with Windows" loc:Loc.ItName="Avvia con Windows" AutomationProperties.AccessibilityView="Control" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          MinWidth="0"
                                          OnContent="" OffContent=""
                                          Toggled="StartupSwitch_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <!-- What this PC is used for. Strings are set in SettingsView.SetupProfile.cs (IT/EN). Changing it
                             never deletes anything; it only changes what starts and which workspaces are shown. Placed after the
                             existing rows so their positions do not move. -->
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="SetupProfileTitle" Text="What PaRuX is for" loc:Loc.ItText="A cosa serve PaRuX" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="SetupProfileHint" AutomationProperties.AutomationId="Settings_SetupProfile_Hint" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="SetupProfileCombo" AutomationProperties.AutomationId="Settings_SetupProfile_ComboBox"
                                      AutomationProperties.Name="What PaRuX is for" loc:Loc.ItName="A cosa serve PaRuX" AutomationProperties.AccessibilityView="Control"
                                      Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                                      CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                      SelectionChanged="SetupProfileCombo_SelectionChanged">
                                <ComboBoxItem Tag="both" AutomationProperties.AutomationId="Settings_SetupProfile_Both_Item" />
                                <ComboBoxItem Tag="ai" AutomationProperties.AutomationId="Settings_SetupProfile_Ai_Item" />
                                <ComboBoxItem Tag="gaming" AutomationProperties.AutomationId="Settings_SetupProfile_Gaming_Item" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <!-- "Use for" role profiles (Chat / Coding / Reasoning / Vision / Documents). The panel is created in
                             SettingsView.SetupProfile.cs; it only reads installed models and the existing role store. -->
                        <ContentControl x:Name="RoleProfileHost" IsTabStop="False" HorizontalContentAlignment="Stretch" />

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Notifications ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="General">
                <TextBlock Text="NOTIFICATIONS" loc:Loc.ItText="NOTIFICHE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Media generation" loc:Loc.ItText="Generazione multimediale" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Notify when long image or video generation finishes in the background." loc:Loc.ItText="Avvisa quando una lunga generazione di immagini o video termina in background." Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotificationsGenerationSwitch"
                                          AutomationProperties.AutomationId="Settings_NotificationsGeneration_Toggle"
                                          AutomationProperties.Name="Media generation notifications" loc:Loc.ItName="Notifiche di generazione multimediale"
                                          AutomationProperties.AccessibilityView="Control"
                                          Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          Toggled="NotificationsGenerationSwitch_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Model downloads" loc:Loc.ItText="Download dei modelli" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Notify when a model or checkpoint download completes or fails." loc:Loc.ItText="Avvisa quando il download di un modello o di un checkpoint termina o fallisce." Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotificationsDownloadsSwitch"
                                          AutomationProperties.AutomationId="Settings_NotificationsDownloads_Toggle"
                                          AutomationProperties.Name="Model download notifications" loc:Loc.ItName="Notifiche di download dei modelli"
                                          AutomationProperties.AccessibilityView="Control"
                                          Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          Toggled="NotificationsDownloadsSwitch_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Send voice messages automatically" loc:Loc.ItText="Invia automaticamente i messaggi vocali" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Off by default. When on, the Chat microphone sends the transcribed text right away instead of placing it in the prompt box for you to review." loc:Loc.ItText="Disattivato di default. Se attivo, il microfono della Chat invia subito il testo trascritto invece di inserirlo nella casella del prompt per la tua revisione." Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="VoiceAutoSendSwitch"
                                          AutomationProperties.AutomationId="Settings_VoiceAutoSend_Toggle"
                                          AutomationProperties.Name="Send voice messages automatically" loc:Loc.ItName="Invia automaticamente i messaggi vocali"
                                          AutomationProperties.AccessibilityView="Control"
                                          Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          Toggled="VoiceAutoSendSwitch_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Runtime installs" loc:Loc.ItText="Installazioni dei runtime" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Notify when a runtime engine install completes or fails." loc:Loc.ItText="Avvisa quando l&#x27;installazione di un motore runtime termina o fallisce." Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="NotificationsInstallsSwitch"
                                          AutomationProperties.AutomationId="Settings_NotificationsInstalls_Toggle"
                                          AutomationProperties.Name="Runtime install notifications" loc:Loc.ItName="Notifiche di installazione dei runtime"
                                          AutomationProperties.AccessibilityView="Control"
                                          Grid.Column="1" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                          Toggled="NotificationsInstallsSwitch_Toggled" />
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Quick Chat bubble ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="General">
                <TextBlock Text="QUICK CHAT BUBBLE" loc:Loc.ItText="BOLLA CHAT RAPIDA" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Visibility" loc:Loc.ItText="Visibilità" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock
                                    Text="When the floating bubble appears on screen." loc:Loc.ItText="Quando la bolla flottante compare sullo schermo."
                                    Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="BubbleCombo" AutomationProperties.Name="Bubble mode" loc:Loc.ItName="Modalità della bolla" Grid.Column="1" MinWidth="200"
                                      VerticalAlignment="Center"
                                      CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                      SelectionChanged="BubbleCombo_SelectionChanged">
                                <ComboBoxItem Content="Always visible" loc:Loc.ItContent="Sempre visibile" Tag="AlwaysVisible" />
                                <ComboBoxItem Content="Auto-hide (fade when idle)" loc:Loc.ItContent="Nascondi automaticamente (sfuma se inattiva)" Tag="AutoHide" />
                                <ComboBoxItem Content="Hotkey only" loc:Loc.ItContent="Solo con scorciatoia" Tag="HotkeyOnly" />
                                <ComboBoxItem Content="Disabled" loc:Loc.ItContent="Disattivata" Tag="Disabled" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Global hotkey" loc:Loc.ItText="Scorciatoia globale" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="HotkeyHint"
                                           Text="Opens Quick Chat from anywhere, e.g. Ctrl+Alt+Space." loc:Loc.ItText="Apre la Chat rapida da qualsiasi punto, ad es. Ctrl+Alt+Spazio."
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <TextBox x:Name="HotkeyBox" AutomationProperties.Name="Global hotkey" loc:Loc.ItName="Scorciatoia globale" Grid.Column="1" MinWidth="160"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     CornerRadius="{StaticResource PaRuXRadiusSmall}" />
                            <Button x:Name="ApplyHotkeyButton" Grid.Column="2" Content="Apply" loc:Loc.ItContent="Applica"
                                    VerticalAlignment="Center"
                                    Height="32"
                                    Padding="16,0,16,0"
                                    CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                    Click="ApplyHotkey_Click" />
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Models ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="MODELS" loc:Loc.ItText="MODELLI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Default text profile" loc:Loc.ItText="Profilo di testo predefinito" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock
                                    Text="Auto leaves whichever profile is already loaded untouched." loc:Loc.ItText="Auto non tocca il profilo già caricato."
                                    Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ProfileCombo" AutomationProperties.Name="Profile" loc:Loc.ItName="Profilo" Grid.Column="1" MinWidth="160"
                                      VerticalAlignment="Center"
                                      CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                      SelectionChanged="ProfileCombo_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="AUTO" />
                                <ComboBoxItem Content="Standard" Tag="STANDARD" />
                                <ComboBoxItem Content="Uncensored" loc:Loc.ItContent="Senza censura" Tag="UNCENSORED" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Auto-escalate to Uncensored" loc:Loc.ItText="Passa automaticamente a Senza censura" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock
                                    Text="When Standard declines or falls short, silently retry the same message on Uncensored." loc:Loc.ItText="Se Standard rifiuta o non basta, riprova in silenzio lo stesso messaggio con Senza censura."
                                    Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock x:Name="AutoFallbackStatusText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoFallbackSwitch" Grid.Column="1"
                                          OffContent="Off" loc:Loc.ItOffContent="Disattivato" OnContent="On" VerticalAlignment="Center"
                                          Toggled="AutoFallbackSwitch_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Detected local models (.gguf)" loc:Loc.ItText="Modelli locali rilevati (.gguf)" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Rescan" loc:Loc.ItContent="Riesamina" Click="RescanModels_Click" />
                        </Grid>
                        <TextBlock
                            Text="Which downloaded file backs Standard and Uncensored - pick a different one below, or leave the built-in defaults." loc:Loc.ItText="Quale file scaricato sta dietro Standard e Senza censura: scegline uno diverso qui sotto oppure lascia i predefiniti integrati."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXSubtleCaptionStyle}"
                            Margin="0,4,0,0" />
                        <TextBlock x:Name="ModelRoleStatusText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel x:Name="DetectedModelsList" Spacing="6" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== External text backend ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="EXTERNAL TEXT BACKEND" loc:Loc.ItText="BACKEND DI TESTO ESTERNO" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Point chat at a local OpenAI-compatible server you're already running (Ollama, LM Studio, koboldcpp, text-generation-webui, ...) instead of PaRuX's own bundled model. PaRuX neither starts nor manages it - just checks it's reachable before sending a request." loc:Loc.ItText="Collega la chat a un server locale compatibile con OpenAI che stai già eseguendo (Ollama, LM Studio, koboldcpp, text-generation-webui, ...) invece del modello incluso in PaRuX. PaRuX non lo avvia né lo gestisce: controlla solo che sia raggiungibile prima di inviare una richiesta."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBlock x:Name="ExternalBackendStatusText" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <Button x:Name="ClearExternalBackendButton" Content="Use PaRuX's own local model" loc:Loc.ItContent="Usa il modello locale di PaRuX" Margin="0,6,0,0" Click="ClearExternalBackend_Click" Visibility="Collapsed" />

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Detect running backends" loc:Loc.ItText="Rileva i backend in esecuzione" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="DetectBackendsButton" Content="Detect" loc:Loc.ItContent="Rileva" Click="DetectBackends_Click" />
                        </Grid>
                        <StackPanel x:Name="DetectedBackendsList" Spacing="6" Margin="0,8,0,0" />

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <TextBlock Text="Or enter one manually" loc:Loc.ItText="Oppure inseriscilo a mano" Style="{StaticResource PaRuXBodyStrongTextStyle}" Margin="0,0,0,6" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManualBackendNameBox" Grid.Column="0" PlaceholderText="Name (e.g. Ollama)" loc:Loc.ItPlaceholder="Nome (ad es. Ollama)" />
                            <TextBox x:Name="ManualBackendEndpointBox" Grid.Column="1" PlaceholderText="http://127.0.0.1:11434" />
                            <Button Grid.Column="2" Content="Use" loc:Loc.ItContent="Usa" Click="SetManualBackend_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Guided tour ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="General">
                <TextBlock Text="FINDING YOUR WAY AROUND" loc:Loc.ItText="PER ORIENTARTI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="PaRuX shows a short walkthrough of the sidebar the first time you finish setup. Run it again whenever you want - it points at each section and says what it is for." loc:Loc.ItText="PaRuX mostra una breve visita guidata della barra laterale la prima volta che termini la configurazione. Eseguila di nuovo quando vuoi: indica ogni sezione e a cosa serve."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Button x:Name="ShowGuidedTourButton" Content="Show me around" loc:Loc.ItContent="Fammi vedere" Margin="0,10,0,0" Click="ShowGuidedTour_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Your PC apps ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Your PC apps">
                <TextBlock Text="APPS ON THIS PC" loc:Loc.ItText="APP SU QUESTO PC" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="PaRuX can answer from the apps you already use - your notes, your mail, your calendar, your bookmarks - by reading their files on this PC. Nothing is connected until you connect it, every source is read-only, each one is limited to the single folder or file you choose, and every answer cites the file it came from. Connecting a source sends nothing anywhere: the reading happens here." loc:Loc.ItText="PaRuX può rispondere usando le app che già usi (note, posta, calendario, segnalibri) leggendone i file su questo PC. Nulla è collegato finché non lo colleghi tu, ogni fonte è di sola lettura, ciascuna è limitata alla singola cartella o al singolo file che scegli e ogni risposta cita il file da cui proviene. Collegare una fonte non invia nulla da nessuna parte: la lettura avviene qui."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}" Margin="0,10,0,0">
                            <Button x:Name="RefreshDesktopIntegrationsButton" Content="Scan this PC" loc:Loc.ItContent="Analizza questo PC" Click="RefreshDesktopIntegrations_Click" />
                            <TextBlock x:Name="DesktopIntegrationsStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PaRuXSubtleCaptionStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="DesktopIntegrationsList" Spacing="{StaticResource PaRuXSpaceS}" Margin="0,12,0,0" />

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <TextBlock Text="Documents PaRuX writes" loc:Loc.ItText="Documenti che PaRuX scrive" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock
                            Text="PaRuX can also create Word and Excel files for you. It writes only new files, only into this one folder - never into the folders it reads from, and never over a file that already exists: a name that is taken gets &quot;(2)&quot; added, the way a download would." loc:Loc.ItText="PaRuX può anche creare file Word ed Excel per te. Scrive solo file nuovi, solo in questa cartella (mai nelle cartelle che legge) e mai sopra un file esistente: a un nome già occupato viene aggiunto &quot;(2)&quot;, come farebbe un download."
                            TextWrapping="Wrap"
                            Margin="0,4,0,0"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}" Margin="0,8,0,0">
                            <Button x:Name="ChooseDocumentOutputButton" Content="Choose folder" loc:Loc.ItContent="Scegli la cartella" Click="ChooseDocumentOutput_Click" />
                            <Button x:Name="ResetDocumentOutputButton" Content="Use PaRuX's folder" loc:Loc.ItContent="Usa la cartella di PaRuX" Click="ResetDocumentOutput_Click" />
                            <TextBlock x:Name="DocumentOutputText" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PaRuXSubtleCaptionStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <TextBlock
                            Text="Using an app that isn't listed? Export from it to a folder of .eml (mail), .ics (calendar) or Markdown/text (notes) and connect that folder - Outlook, Apple Mail, Notion, Evernote and Joplin all export to one of those." loc:Loc.ItText="Usi un&#x27;app che non è nell&#x27;elenco? Esportane i dati in una cartella di file .eml (posta), .ics (calendario) o Markdown/testo (note) e collega quella cartella: Outlook, Apple Mail, Notion, Evernote e Joplin esportano tutti in uno di questi formati."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXSubtleCaptionStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Cloud fallback ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="CLOUD FALLBACK (OPTIONAL)" loc:Loc.ItText="FALLBACK NEL CLOUD (FACOLTATIVO)" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="PaRuX runs entirely on this device. This is the one exception, and it is off unless you turn it on: if local inference cannot serve a turn at all - no model installed, the runtime will not start, not enough VRAM - PaRuX may answer that single turn through an OpenAI-compatible API instead of failing. It is never used while local inference is working, never during Gaming Mode, and every turn it serves is announced in the chat before the answer starts." loc:Loc.ItText="PaRuX funziona interamente su questo dispositivo. Questa è l&#x27;unica eccezione ed è disattivata finché non la attivi: se l&#x27;inferenza locale non riesce a gestire un turno (nessun modello installato, il runtime non si avvia, VRAM insufficiente) PaRuX può rispondere a quel singolo turno tramite un&#x27;API compatibile con OpenAI invece di fallire. Non viene mai usata mentre l&#x27;inferenza locale funziona, né durante la Modalità Gaming, e ogni turno gestito è annunciato nella chat prima della risposta."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />

                        <ToggleSwitch
                            x:Name="CloudFallbackToggle"
                            Header="Allow a cloud fallback when local inference fails" loc:Loc.ItHeader="Consenti un fallback nel cloud quando l&#x27;inferenza locale fallisce"
                            OnContent="On"
                            OffContent="Off" loc:Loc.ItOffContent="Disattivato"
                            Margin="0,10,0,0"
                            Toggled="CloudFallbackToggle_Toggled" />

                        <StackPanel x:Name="CloudFallbackDetailPanel" Visibility="Collapsed" Spacing="{StaticResource PaRuXSpaceS}" Margin="0,6,0,0">
                            <ComboBox
                                x:Name="CloudFallbackProviderCombo"
                                Header="Provider"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CloudFallbackProvider_SelectionChanged" />
                            <TextBox
                                x:Name="CloudFallbackBaseUrlBox"
                                Header="API base URL" loc:Loc.ItHeader="URL di base dell&#x27;API"
                                PlaceholderText="https://your-gateway.example.com/v1" />
                            <TextBox
                                x:Name="CloudFallbackModelBox"
                                Header="Model id" loc:Loc.ItHeader="ID del modello"
                                PlaceholderText="openai/gpt-oss-120b" />
                            <PasswordBox
                                x:Name="CloudFallbackApiKeyBox"
                                Header="API key" loc:Loc.ItHeader="Chiave API"
                                PlaceholderText="Leave blank to keep the saved key" loc:Loc.ItPlaceholder="Lascia vuoto per mantenere la chiave salvata" />
                            <TextBlock
                                Text="The key is encrypted with Windows DPAPI for your account and never leaves PaRuX Core. It is sent to the provider you chose and to nobody else." loc:Loc.ItText="La chiave è cifrata con Windows DPAPI per il tuo account e non lascia mai PaRuX Core. Viene inviata al provider che hai scelto e a nessun altro."
                                TextWrapping="Wrap"
                                Style="{StaticResource PaRuXSubtleCaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                                <Button x:Name="SaveCloudFallbackButton" Content="Save" loc:Loc.ItContent="Salva" Click="SaveCloudFallback_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="TestCloudFallbackButton" Content="Test connection" loc:Loc.ItContent="Prova la connessione" Click="TestCloudFallback_Click" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="CloudFallbackStatusText" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock x:Name="CloudFallbackLastUsedText" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource PaRuXSubtleCaptionStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Media checkpoints ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="GENERATION CHECKPOINTS" loc:Loc.ItText="CHECKPOINT DI GENERAZIONE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Which real checkpoint file image/video/edit generation actually uses. Everything found in ComfyUI's diffusion_models folder shows up here - download an alternative into that folder and it becomes pickable, per generation type, without touching a workflow file by hand." loc:Loc.ItText="Quale file checkpoint reale usano davvero la generazione di immagini, video e modifiche. Tutto ciò che si trova nella cartella diffusion_models di ComfyUI compare qui: scarica un&#x27;alternativa in quella cartella e diventa selezionabile, per tipo di generazione, senza modificare a mano un file di workflow."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBlock
                            Text="Content lane for image, video and edit generation. Automatic mode picks the model per prompt inside this lane; a model you pin in Create always wins." loc:Loc.ItText="Corsia di contenuti per la generazione di immagini, video e modifiche. La modalità automatica sceglie il modello per ogni prompt all&#x27;interno di questa corsia; un modello fissato in Crea ha sempre la precedenza."
                            TextWrapping="Wrap"
                            Margin="0,10,0,0"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="MediaLaneHost" Margin="0,6,0,0" />
                        <StackPanel x:Name="MediaCheckpointsList" Spacing="10" Margin="0,10,0,0" />
                        <TextBlock
                            Text="Recommended alternatives to download" loc:Loc.ItText="Alternative consigliate da scaricare"
                            Style="{StaticResource PaRuXBodyStrongTextStyle}"
                            Margin="0,16,0,4" />
                        <TextBlock
                            Text="Only checkpoints from the same model family already wired into each type's workflow - a drop-in swap, not a general model catalog." loc:Loc.ItText="Solo checkpoint della stessa famiglia di modelli già collegata al workflow di ogni tipo: una sostituzione diretta, non un catalogo generale di modelli."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="RecommendedCheckpointsList" Spacing="10" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Custom workflows ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="CUSTOM WORKFLOWS" loc:Loc.ItText="WORKFLOW PERSONALIZZATI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Text="Bring your own ComfyUI workflow instead of PaRuX's built-in ones. Export a workflow from ComfyUI's own web UI as &quot;API format&quot; (Workflow menu -&gt; Export (API)) and import the JSON file here. PaRuX auto-detects a prompt node, a seed node, a source-image node, and the save node by their ComfyUI class - any it can't find just keeps that workflow's own baked-in value. Still-image workflows (a SaveImage node) only, for now." loc:Loc.ItText="Usa un tuo workflow ComfyUI al posto di quelli integrati di PaRuX. Esporta un workflow dalla web UI di ComfyUI in &quot;formato API&quot; (menu Workflow -&gt; Export (API)) e importa qui il file JSON. PaRuX rileva da solo un nodo prompt, un nodo seed, un nodo immagine di origine e il nodo di salvataggio in base alla loro classe ComfyUI: quelli che non trova mantengono il valore già presente nel workflow. Per ora solo workflow per immagini fisse (con un nodo SaveImage)."
                            TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="CustomWorkflowsList" Spacing="10" Margin="0,10,0,0" />
                        <Button x:Name="ImportWorkflowButton" Content="Import workflow…" loc:Loc.ItContent="Importa workflow…" Margin="0,12,0,0" Click="ImportWorkflow_Click" />
                        <TextBlock x:Name="ImportWorkflowStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Images ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="IMAGES" loc:Loc.ItText="IMMAGINI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Resolution preset" loc:Loc.ItText="Preset di risoluzione" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                    Text="Resolution only — the local image workflow does not expose a steps/quality control the way video does." loc:Loc.ItText="Solo risoluzione: il workflow locale per le immagini non espone un controllo di passaggi/qualità come avviene per i video." />
                            </StackPanel>
                            <ComboBox x:Name="ImagePresetCombo" AutomationProperties.Name="Image preset" loc:Loc.ItName="Preset immagine" Grid.Column="1" MinWidth="170" SelectionChanged="ImagePresetCombo_SelectionChanged">
                                <ComboBoxItem Content="512 × 512" Tag="512x512" />
                                <ComboBoxItem Content="768 × 768" Tag="768x768" />
                                <ComboBoxItem Content="1024 × 1024" Tag="1024x1024" />
                                <ComboBoxItem Content="1440 × 1440" Tag="1440x1440" />
                                <ComboBoxItem Content="2K · 2048 × 2048" Tag="2048x2048" />
                                <ComboBoxItem Content="Custom" loc:Loc.ItContent="Personalizzato" Tag="custom" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Generated resolution" loc:Loc.ItText="Risoluzione generata" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="512–2048 pixels; values are normalized to multiples of 64." loc:Loc.ItText="Da 512 a 2048 pixel; i valori vengono normalizzati a multipli di 64."
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="ImageWidthBox" Grid.Column="1" Width="104" Header="Width" loc:Loc.ItHeader="Larghezza"
                                       Minimum="512" Maximum="2048" SmallChange="64"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="ImageNumberBox_ValueChanged" />
                            <NumberBox x:Name="ImageHeightBox" Grid.Column="2" Width="104" Header="Height" loc:Loc.ItHeader="Altezza"
                                       Minimum="512" Maximum="2048" SmallChange="64"
                                       SpinButtonPlacementMode="Compact"
                                       ValueChanged="ImageNumberBox_ValueChanged" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Image input limits" loc:Loc.ItText="Limiti delle immagini in ingresso" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Adjust these limits for the memory available on this device." loc:Loc.ItText="Regola questi limiti in base alla memoria disponibile su questo dispositivo."
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="MaxImagesBox" Grid.Column="1" Width="104" Header="Files" loc:Loc.ItHeader="File"
                                       Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact"
                                       ValueChanged="ImageNumberBox_ValueChanged" />
                            <NumberBox x:Name="MaxImageMegabytesBox" Grid.Column="2" Width="104" Header="MB each" loc:Loc.ItHeader="MB ciascuno"
                                       Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact"
                                       ValueChanged="ImageNumberBox_ValueChanged" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />

                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Generated images folder" loc:Loc.ItText="Cartella delle immagini generate" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="ImageFolderPath" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Choose…" loc:Loc.ItContent="Scegli…" Click="ChooseImageFolder_Click"
                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Reset" loc:Loc.ItContent="Reimposta" Click="ResetImageFolder_Click"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Videos ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="VIDEOS" loc:Loc.ItText="VIDEO" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Output quality preset" loc:Loc.ItText="Preset di qualità in uscita" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Sets resolution and render steps together. Standard (720p) is the default; higher tiers take substantially longer." loc:Loc.ItText="Imposta insieme risoluzione e passaggi di rendering. Standard (720p) è il predefinito; i livelli più alti richiedono molto più tempo." Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="VideoPresetCombo" AutomationProperties.Name="Video preset" loc:Loc.ItName="Preset video" Grid.Column="1" MinWidth="200" SelectionChanged="VideoPresetCombo_SelectionChanged">
                                <ComboBoxItem Content="Fast preview · 640×360 · 12 steps" loc:Loc.ItContent="Anteprima rapida · 640×360 · 12 passaggi" Tag="640x360x12" />
                                <ComboBoxItem Content="Draft · 832×448 · 16 steps" loc:Loc.ItContent="Bozza · 832×448 · 16 passaggi" Tag="832x448x16" />
                                <ComboBoxItem Content="Standard · 1280×720 · 30 steps" loc:Loc.ItContent="Standard · 1280×720 · 30 passaggi" Tag="1280x720x30" />
                                <ComboBoxItem Content="High · 1920×1080 · 40 steps" loc:Loc.ItContent="Alta · 1920×1080 · 40 passaggi" Tag="1920x1080x40" />
                                <ComboBoxItem Content="Ultra · 2560×1440 · 50 steps" loc:Loc.ItContent="Ultra · 2560×1440 · 50 passaggi" Tag="2560x1440x50" />
                                <ComboBoxItem Content="4K · 3840×2160 · 60 steps" loc:Loc.ItContent="4K · 3840×2160 · 60 passaggi" Tag="3840x2160x60" />
                                <ComboBoxItem Content="Custom" loc:Loc.ItContent="Personalizzato" Tag="custom" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Generated resolution" loc:Loc.ItText="Risoluzione generata" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Custom output, normalized to multiples of 8 for the local workflow." loc:Loc.ItText="Output personalizzato, normalizzato a multipli di 8 per il workflow locale." Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="VideoWidthBox" Grid.Column="1" Width="112" Header="Width" loc:Loc.ItHeader="Larghezza" Minimum="256" Maximum="3840" SmallChange="8" SpinButtonPlacementMode="Compact" ValueChanged="VideoNumberBox_ValueChanged" />
                            <NumberBox x:Name="VideoHeightBox" Grid.Column="2" Width="112" Header="Height" loc:Loc.ItHeader="Altezza" Minimum="256" Maximum="2160" SmallChange="8" SpinButtonPlacementMode="Compact" ValueChanged="VideoNumberBox_ValueChanged" />
                        </Grid>
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Render quality" loc:Loc.ItText="Qualità di rendering" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="More inference steps improve detail and stability at the cost of waiting time." loc:Loc.ItText="Più passaggi di inferenza migliorano dettaglio e stabilità a costo di un&#x27;attesa maggiore." Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <NumberBox x:Name="VideoStepsBox" Grid.Column="1" Width="112" Header="Steps" loc:Loc.ItHeader="Passaggi" Minimum="8" Maximum="60" SmallChange="2" SpinButtonPlacementMode="Compact" ValueChanged="VideoNumberBox_ValueChanged" />
                            <NumberBox x:Name="VideoFpsBox" Grid.Column="2" Width="112" Header="FPS" Minimum="8" Maximum="60" SpinButtonPlacementMode="Compact" ValueChanged="VideoNumberBox_ValueChanged" />
                        </Grid>
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Timeline" loc:Loc.ItText="Durata" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Long requests are split into coherent clips and finalized to this duration." loc:Loc.ItText="Le richieste lunghe vengono suddivise in clip coerenti e rifinite fino a questa durata." Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="VideoDurationBox" Grid.Column="1" Width="112" Header="Seconds" loc:Loc.ItHeader="Secondi" Minimum="1" Maximum="60" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="VideoNumberBox_ValueChanged" />
                        </Grid>
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Video input limit" loc:Loc.ItText="Limite del video in ingresso" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Maximum size for a video attached to one chat message." loc:Loc.ItText="Dimensione massima di un video allegato a un singolo messaggio della chat." Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="MaxVideoMegabytesBox" Grid.Column="1" Width="112" Header="MB" Minimum="10" Maximum="4096" SmallChange="50" SpinButtonPlacementMode="Compact" ValueChanged="VideoNumberBox_ValueChanged" />
                        </Grid>
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Generated videos folder" loc:Loc.ItText="Cartella dei video generati" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="VideoFolderPath" TextTrimming="CharacterEllipsis" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Choose…" loc:Loc.ItContent="Scegli…" Click="ChooseVideoFolder_Click" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Reset" loc:Loc.ItContent="Reimposta" Click="ResetVideoFolder_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Gaming ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Privacy &amp; Network">
                <TextBlock Text="GAMING" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hard-off protection" loc:Loc.ItText="Protezione hard-off" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <TextBlock x:Name="GamingStatusText" Text="Checking gaming state…" loc:Loc.ItText="Controllo dello stato Gaming…" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        </StackPanel>
                        <Button x:Name="EnterGamingButton" Grid.Column="1" Content="Enter Gaming Mode" loc:Loc.ItContent="Entra in Modalità Gaming" Click="EnterGamingMode_Click" VerticalAlignment="Center" />
                        <Button x:Name="ExitGamingButton" Grid.Column="2" Content="Exit Gaming Mode" loc:Loc.ItContent="Esci dalla Modalità Gaming" Click="ExitGamingMode_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== LAN access ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Privacy &amp; Network">
                <TextBlock Text="LOCAL NETWORK" loc:Loc.ItText="RETE LOCALE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Remote access" loc:Loc.ItText="Accesso remoto" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Off by default. When enabled, PaRuX binds only to the selected private IPv4 address over HTTPS. No cloud, UPnP, router changes, or Internet exposure." loc:Loc.ItText="Disattivato di default. Se attivo, PaRuX si lega solo all&#x27;indirizzo IPv4 privato selezionato tramite HTTPS. Nessun cloud, UPnP, modifica del router o esposizione a Internet." TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LanEnabledSwitch" Grid.Column="1" OffContent="Off" loc:Loc.ItOffContent="Disattivato" OnContent="On" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="LanAddressCombo" Grid.Column="0" Header="Private network interface" loc:Loc.ItHeader="Interfaccia di rete privata" PlaceholderText="No private IPv4 interface found" loc:Loc.ItPlaceholder="Nessuna interfaccia IPv4 privata trovata" />
                            <NumberBox x:Name="LanPortBox" Grid.Column="1" Header="Port" loc:Loc.ItHeader="Porta" Minimum="1024" Maximum="65535" Value="51124" SpinButtonPlacementMode="Compact" />
                            <Button x:Name="ApplyLanButton" Grid.Column="2" Content="Apply &amp; restart Core" loc:Loc.ItContent="Applica e riavvia Core" Click="ApplyRemoteAccess_Click" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </Grid>
                        <TextBlock x:Name="LanStatusText" Text="Checking local-network status…" loc:Loc.ItText="Controllo dello stato della rete locale…" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Border Style="{StaticResource PaRuXDividerStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Pair a device" loc:Loc.ItText="Associa un dispositivo" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Creates a one-time eight-digit code valid for five minutes. Each device receives its own revocable token." loc:Loc.ItText="Crea un codice monouso di otto cifre valido cinque minuti. Ogni dispositivo riceve un proprio token revocabile." TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <Button x:Name="PairDeviceButton" Grid.Column="1" Content="Create pairing code" loc:Loc.ItContent="Crea codice di associazione" Click="PairDevice_Click" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceL}">
                            <Border Width="176" Height="176" Padding="8" Visibility="Collapsed"
                                    x:Name="PairingQrBorder"
                                    Background="White"
                                    CornerRadius="{StaticResource PaRuXRadiusMedium}"
                                    BorderBrush="{ThemeResource PaRuXStrokeBrush}" BorderThickness="1">
                                <Image x:Name="PairingQrImage" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="PairingCodeText" Visibility="Collapsed" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource PaRuXBodyTextStyle}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel x:Name="PairedDevicesList" Spacing="{StaticResource PaRuXSpaceS}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Browser access ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Privacy &amp; Network">
                <TextBlock Text="BROWSER ACCESS" loc:Loc.ItText="ACCESSO DAL BROWSER" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Open PaRuX in a browser" loc:Loc.ItText="Apri PaRuX in un browser" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                    Text="Off by default. When on, PaRuX serves its full web interface on this PC's loopback address, so you can put Nginx Proxy Manager, Caddy or Traefik in front of it and reach PaRuX from another computer. A passphrase is required — once a proxy is in front, it is the only thing between the Internet and this PC. Inference still runs here and nothing is sent to a cloud provider." loc:Loc.ItText="Disattivato di default. Se attivo, PaRuX serve la sua interfaccia web completa sull&#x27;indirizzo di loopback di questo PC, così puoi metterci davanti Nginx Proxy Manager, Caddy o Traefik e raggiungere PaRuX da un altro computer. È richiesta una passphrase: con un proxy davanti, è l&#x27;unica cosa che separa Internet da questo PC. L&#x27;inferenza continua a girare qui e nulla viene inviato a un provider cloud." />
                            </StackPanel>
                            <ToggleSwitch x:Name="WebAccessSwitch" Grid.Column="1" OffContent="Off" loc:Loc.ItOffContent="Disattivato" OnContent="On" VerticalAlignment="Center" Toggled="WebAccessSwitch_Toggled" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="WebAccessPassphraseBox" Grid.Column="0" Header="Passphrase (at least 12 characters)" loc:Loc.ItHeader="Passphrase (almeno 12 caratteri)" PlaceholderText="Set or replace the passphrase" loc:Loc.ItPlaceholder="Imposta o sostituisci la passphrase" />
                            <Button x:Name="SetWebPassphraseButton" Grid.Column="1" Content="Set passphrase" loc:Loc.ItContent="Imposta la passphrase" Click="SetWebPassphrase_Click" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </Grid>
                        <TextBlock x:Name="WebAccessStatusText" Text="Checking browser-access status…" loc:Loc.ItText="Controllo dello stato dell&#x27;accesso dal browser…" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                Text="Point your reverse proxy at http://127.0.0.1:51123 and let it terminate HTTPS. PaRuX never opens a firewall port or changes a network setting for you." loc:Loc.ItText="Punta il reverse proxy su http://127.0.0.1:51123 e lascia che gestisca l&#x27;HTTPS. PaRuX non apre mai una porta del firewall né modifica impostazioni di rete al posto tuo." />
                            <Button x:Name="OpenWebClientButton" Grid.Column="1" Content="Open in browser" loc:Loc.ItContent="Apri nel browser" Click="OpenWebClient_Click" VerticalAlignment="Center" />
                            <Button x:Name="SignOutWebSessionsButton" Grid.Column="2" Content="Sign out all browsers" loc:Loc.ItContent="Disconnetti tutti i browser" Click="SignOutWebSessions_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== API keys ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Privacy &amp; Network">
                <TextBlock Text="API KEYS" loc:Loc.ItText="CHIAVI API" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Use PaRuX from other apps" loc:Loc.ItText="Usa PaRuX da altre app" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                Text="Apps and coding agents should use the Local AI Gateway (Settings › Integrations): http://127.0.0.1:11435 with the Anthropic Messages, OpenAI Responses or OpenAI Chat Completions API. Tools built for Ollama can also point at http://127.0.0.1:51123 (/api/chat, /api/generate, /api/tags) — no Ollama install is needed. Paste a key below as the API key or bearer token. A key buys inference only — it can never read your conversations, change settings, or reach anything else on this PC." loc:Loc.ItText="App e agenti di programmazione dovrebbero usare il Local AI Gateway (Impostazioni › Integrazioni): http://127.0.0.1:11435 con l&#x27;API Anthropic Messages, OpenAI Responses o OpenAI Chat Completions. Anche gli strumenti pensati per Ollama possono puntare a http://127.0.0.1:51123 (/api/chat, /api/generate, /api/tags) — non serve installare Ollama. Incolla qui sotto una chiave come chiave API o bearer token. Una chiave dà accesso solo all&#x27;inferenza: non può mai leggere le tue conversazioni, cambiare impostazioni o raggiungere altro su questo PC." />
                        </StackPanel>
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiKeyNameBox" Grid.Column="0" Header="Name this key" loc:Loc.ItHeader="Dai un nome a questa chiave" PlaceholderText="e.g. Open WebUI on the laptop" loc:Loc.ItPlaceholder="ad es. Open WebUI sul portatile" />
                            <Button x:Name="CreateApiKeyButton" Grid.Column="1" Content="Create key" loc:Loc.ItContent="Crea chiave" Click="CreateApiKey_Click" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </Grid>
                        <Border x:Name="NewApiKeyPanel" Visibility="Collapsed" Padding="10" CornerRadius="{StaticResource PaRuXRadiusMedium}"
                                BorderBrush="{ThemeResource PaRuXStrokeBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Copy this key now — PaRuX keeps only a hash and cannot show it again." loc:Loc.ItText="Copia ora questa chiave: PaRuX ne conserva solo un hash e non può mostrartela di nuovo."
                                           TextWrapping="Wrap" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBox x:Name="NewApiKeyText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
                                <Button x:Name="CopyApiKeyButton" Content="Copy to clipboard" loc:Loc.ItContent="Copia negli appunti" Click="CopyApiKey_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ApiKeyStatusText" Text="Checking API keys…" loc:Loc.ItText="Controllo delle chiavi API…" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="ApiKeyList" Spacing="{StaticResource PaRuXSpaceS}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Computer Use ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Automation">
                <TextBlock Text="COMPUTER USE" loc:Loc.ItText="USO DEL COMPUTER" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Full Computer Use (mouse, keyboard, screen)" loc:Loc.ItText="Uso completo del computer (mouse, tastiera, schermo)" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                    Text="Off by default. When on, a request that isn't just &quot;open an app&quot; may drive the real mouse, keyboard, and screen directly — every step is shown live in the reply, capped at 15 steps, and the Stop button cancels it immediately. Also gates whether Multi-Agent/Autopilot &quot;ui-verification&quot; tasks may capture the screen to check their work. Paired Android devices can start Computer Use tasks on this PC, and while this is on those tasks run without a per-task prompt." loc:Loc.ItText="Disattivato di default. Se attivo, una richiesta che non sia semplicemente &quot;apri un&#x27;app&quot; può controllare direttamente mouse, tastiera e schermo reali: ogni passaggio è mostrato in diretta nella risposta, limitato a 15 passaggi, e il pulsante Stop lo annulla subito. Decide anche se le attività &quot;ui-verification&quot; di Multi-Agent/Autopilot possono catturare lo schermo per verificare il proprio lavoro. I dispositivi Android associati possono avviare attività di Uso del computer su questo PC e, finché questa opzione è attiva, tali attività partono senza una richiesta per ogni attività." />
                            </StackPanel>
                            <ToggleSwitch x:Name="ComputerUseAutomationSwitch" Grid.Column="1"
                                          OffContent="Off" loc:Loc.ItOffContent="Disattivato" OnContent="On" VerticalAlignment="Center"
                                          Toggled="ComputerUseAutomationSwitch_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Allowed apps and emulators" loc:Loc.ItText="App ed emulatori consentiti" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="Discover an open app and approve its executable, or browse to an EXE. Discovery never grants access automatically. Only apps approved here can be launched from chat." loc:Loc.ItText="Individua un&#x27;app aperta e approva il suo eseguibile, oppure scegli un EXE. Il rilevamento non concede mai l&#x27;accesso in automatico. Dalla chat si possono avviare solo le app approvate qui." TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <Button Content="Find open apps…" loc:Loc.ItContent="Trova app aperte…" Click="ChooseRunningComputerApp_Click" AutomationProperties.Name="Discover open desktop apps for approval" loc:Loc.ItName="Individua le app desktop aperte da approvare" />
                                <Button Content="Browse EXE…" loc:Loc.ItContent="Scegli un EXE…" Click="ChooseComputerApp_Click" AutomationProperties.Name="Browse for an executable to approve" loc:Loc.ItName="Scegli un eseguibile da approvare" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ComputerAppsList" Spacing="{StaticResource PaRuXSpaceS}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== MCP servers ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Automation">
                <TextBlock Text="MCP SERVERS" loc:Loc.ItText="SERVER MCP" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Connect PaRuX OUT to third-party MCP servers so the chat model can call their tools directly (real OpenAI-style function calling, not text parsing). Each server is a command PaRuX launches locally, same shape as Claude Desktop's own MCP config - e.g. command 'npx', args '-y @modelcontextprotocol/server-filesystem C:\Users\me\Documents'. A server can do anything its own process is allowed to do, so only add ones you trust." loc:Loc.ItText="Collega PaRuX VERSO server MCP di terze parti così il modello della chat può chiamarne direttamente gli strumenti (vere chiamate di funzione in stile OpenAI, non analisi del testo). Ogni server è un comando che PaRuX avvia in locale, con la stessa forma della configurazione MCP di Claude Desktop, ad es. comando &#x27;npx&#x27;, argomenti &#x27;-y @modelcontextprotocol/server-filesystem C:\Users\me\Documents&#x27;. Un server può fare tutto ciò che il suo processo è autorizzato a fare, quindi aggiungi solo quelli di cui ti fidi." />
                        <StackPanel x:Name="McpServersList" Spacing="6" />

                        <TextBlock Text="Add a server" loc:Loc.ItText="Aggiungi un server" Style="{StaticResource PaRuXBodyStrongTextStyle}" Margin="0,4,0,0" />
                        <ComboBox x:Name="McpPresetCombo" AutomationProperties.Name="MCP server preset" loc:Loc.ItName="Preset del server MCP" PlaceholderText="Pick a known server (optional) - fills in the fields below" loc:Loc.ItPlaceholder="Scegli un server noto (facoltativo): compila i campi qui sotto"
                            HorizontalAlignment="Stretch" SelectionChanged="McpPresetCombo_SelectionChanged" />
                        <TextBox x:Name="NewMcpNameBox" PlaceholderText="Name, e.g. Filesystem" loc:Loc.ItPlaceholder="Nome, ad es. Filesystem" />
                        <TextBox x:Name="NewMcpCommandBox" PlaceholderText="Command, e.g. npx" loc:Loc.ItPlaceholder="Comando, ad es. npx" />
                        <TextBox x:Name="NewMcpArgsBox" PlaceholderText="Args, e.g. -y @modelcontextprotocol/server-filesystem C:\Users\me\Documents" loc:Loc.ItPlaceholder="Argomenti, ad es. -y @modelcontextprotocol/server-filesystem C:\Users\me\Documents" />
                        <Button Content="Add server" loc:Loc.ItContent="Aggiungi il server" HorizontalAlignment="Left" Click="AddMcpServer_Click" />
                        <TextBlock x:Name="McpStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Coding handoff ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Automation">
                <TextBlock Text="CODING HANDOFF" loc:Loc.ItText="PASSAGGIO AL CODING" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="VS Code and OpenCode commands" loc:Loc.ItText="Comandi di VS Code e OpenCode" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <TextBlock Text="Defaults resolve from PATH; use full executable paths when needed." loc:Loc.ItText="I valori predefiniti vengono risolti dal PATH; usa i percorsi completi degli eseguibili quando serve." TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        </StackPanel>
                        <TextBox x:Name="VsCodeCommandBox" Grid.Column="1" Header="VS Code" />
                        <TextBox x:Name="OpenCodeCommandBox" Grid.Column="2" Header="OpenCode" />
                        <Button Grid.Column="3" Content="Apply" loc:Loc.ItContent="Applica" Click="ApplyCodingCommands_Click" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== Agent Command Center ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Agents">
                <TextBlock Text="AGENT COMMAND CENTER" loc:Loc.ItText="CENTRO DI COMANDO DEGLI AGENTI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Coding agent workspace" loc:Loc.ItText="Area di lavoro dell&#x27;agente di programmazione" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Git repository the desktop Coding Agent operates on for 'coding'-role tasks. Every task gets its own isolated git worktree under .parux-agents\ inside this folder - your own working copy is never touched. Leave empty to keep coding tasks dispatched-only (never executed)." loc:Loc.ItText="Repository Git su cui opera l&#x27;agente di programmazione desktop per le attività con ruolo &#x27;coding&#x27;. Ogni attività ha il proprio worktree git isolato in .parux-agents\ dentro questa cartella: la tua copia di lavoro non viene mai toccata. Lascia vuoto per tenere le attività di programmazione solo assegnate (mai eseguite)." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="AgentWorkspaceRootBox" Grid.Column="0" PlaceholderText="e.g. C:\Users\me\Projects\my-repo" loc:Loc.ItPlaceholder="ad es. C:\Users\me\Projects\my-repo" LostFocus="AgentWorkspaceRootBox_LostFocus" />
                            <Button Grid.Column="1" Content="Browse…" loc:Loc.ItContent="Sfoglia…" Click="BrowseAgentWorkspaceRoot_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Give the local Multi-Agent Orchestrator a goal. A background scheduler dispatches it, a role-appropriate local-model worker attempts it, and an independent verifier reviews the result before it's marked complete - entirely on this machine, no cloud involved." loc:Loc.ItText="Dai un obiettivo all&#x27;orchestratore multi-agente locale. Uno scheduler in background lo assegna, un worker con modello locale adatto al ruolo lo affronta e un verificatore indipendente ne controlla il risultato prima di segnarlo come completato: tutto su questa macchina, senza cloud." />
                        <TextBox x:Name="AgentTaskGoalBox" PlaceholderText="Goal, e.g. 'Research the tradeoffs between X and Y'" loc:Loc.ItPlaceholder="Obiettivo, ad es. &#x27;Ricerca i compromessi tra X e Y&#x27;" TextWrapping="Wrap" AcceptsReturn="True" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="AgentTaskRoleBox" Grid.Column="0" Header="Role (optional - AUTO infers one)" loc:Loc.ItHeader="Ruolo (facoltativo: AUTO ne deduce uno)" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="AUTO" Tag="" />
                                <ComboBoxItem Content="Planner" loc:Loc.ItContent="Pianificatore" Tag="planner" />
                                <ComboBoxItem Content="Research" loc:Loc.ItContent="Ricerca" Tag="research" />
                                <ComboBoxItem Content="Review" loc:Loc.ItContent="Revisione" Tag="review" />
                                <ComboBoxItem Content="Documentation" loc:Loc.ItContent="Documentazione" Tag="documentation" />
                                <ComboBoxItem Content="Testing" loc:Loc.ItContent="Test" Tag="testing" />
                                <ComboBoxItem Content="Security" loc:Loc.ItContent="Sicurezza" Tag="security" />
                                <ComboBoxItem Content="Coding" loc:Loc.ItContent="Programmazione" Tag="coding" />
                                <ComboBoxItem Content="UI Verification (requires Full Computer Use below)" loc:Loc.ItContent="Verifica UI (richiede Uso completo del computer qui sotto)" Tag="ui-verification" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="Create task" loc:Loc.ItContent="Crea attività" Click="CreateAgentTask_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="AgentTasksStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AgentTasksCountLabel" Grid.Column="0" Text="0 task(s)" loc:Loc.ItText="0 attività" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshAgentTasks_Click" />
                        </Grid>
                        <StackPanel x:Name="AgentTasksList" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Project Manager + Autopilot ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Agents">
                <TextBlock Text="PROJECTS &amp; AUTOPILOT" loc:Loc.ItText="PROGETTI E AUTOPILOT" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Autonomous Project Manager" loc:Loc.ItText="Project manager autonomo" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Give a large goal and the local model breaks it into a real, dependency-wired task graph through the Multi-Agent Orchestrator above - recorded in the Context Graph, not a separate store." loc:Loc.ItText="Dai un obiettivo ampio e il modello locale lo scompone in un vero grafo di attività con dipendenze tramite l&#x27;orchestratore multi-agente qui sopra, registrato nel Context Graph e non in un archivio separato." />
                        <TextBox x:Name="ProjectGoalBox" PlaceholderText="Goal, e.g. 'Prepare this project for its first public release'" loc:Loc.ItPlaceholder="Obiettivo, ad es. &#x27;Prepara questo progetto per la prima release pubblica&#x27;" TextWrapping="Wrap" AcceptsReturn="True" />
                        <Button Content="Create project" loc:Loc.ItContent="Crea progetto" Click="CreateProject_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ProjectStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProjectsCountLabel" Grid.Column="0" Text="0 project(s)" loc:Loc.ItText="0 progetti" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshProjects_Click" />
                        </Grid>
                        <StackPanel x:Name="ProjectsList" Spacing="8" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Autopilot" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Plan -&gt; gate -&gt; execute -&gt; verify -&gt; report, end to end. SUPERVISED holds every created task until you approve it; BALANCED/AUTONOMOUS start immediately (currently behave the same operationally - no auto-repair loop yet)." loc:Loc.ItText="Pianifica -&gt; approva -&gt; esegui -&gt; verifica -&gt; riferisci, dall&#x27;inizio alla fine. SUPERVISED trattiene ogni attività creata finché non la approvi; BALANCED/AUTONOMOUS partono subito (per ora si comportano allo stesso modo: non c&#x27;è ancora un ciclo di riparazione automatica)." />
                        <TextBox x:Name="AutopilotGoalBox" PlaceholderText="Goal for Autopilot to plan and run" loc:Loc.ItPlaceholder="Obiettivo che Autopilot deve pianificare ed eseguire" TextWrapping="Wrap" AcceptsReturn="True" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="AutopilotModeBox" Grid.Column="0" Header="Permission mode" loc:Loc.ItHeader="Modalità di autorizzazione" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Supervised (hold for approval)" loc:Loc.ItContent="Supervisionata (attendi l&#x27;approvazione)" Tag="supervised" />
                                <ComboBoxItem Content="Balanced" loc:Loc.ItContent="Bilanciata" Tag="balanced" />
                                <ComboBoxItem Content="Autonomous" loc:Loc.ItContent="Autonoma" Tag="autonomous" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="Start run" loc:Loc.ItContent="Avvia l&#x27;esecuzione" Click="StartAutopilotRun_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="AutopilotStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="AutopilotRunIdBox" Grid.Column="0" PlaceholderText="Run id (auto-filled after Start run)" loc:Loc.ItPlaceholder="ID dell&#x27;esecuzione (compilato dopo Avvia l&#x27;esecuzione)" />
                            <Button Grid.Column="1" Content="Check status" loc:Loc.ItContent="Controlla lo stato" Click="CheckAutopilotRun_Click" />
                            <Button Grid.Column="2" Content="Approve" loc:Loc.ItContent="Approva" Click="ApproveAutopilotRun_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}" BorderBrush="{StaticResource PaRuXDotWarnBrush}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="STOP ALL AGENTS" loc:Loc.ItText="FERMA TUTTI GLI AGENTI" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Cancels every in-flight Multi-Agent task, cancels every active Autopilot run, pauses Automations from creating new tasks, and stops the local coding agent / Computer Use if either was invoked directly from chat - without deleting or rewriting any stored data. Does not yet reach Android's on-device Computer Use." loc:Loc.ItText="Annulla ogni attività Multi-Agent in corso, ogni esecuzione Autopilot attiva, sospende la creazione di nuove attività da parte delle Automazioni e ferma l&#x27;agente di programmazione locale / l&#x27;Uso del computer se invocati direttamente dalla chat, senza eliminare né riscrivere alcun dato salvato. Non arriva ancora all&#x27;Uso del computer sul dispositivo Android." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="STOP ALL AGENTS" loc:Loc.ItContent="FERMA TUTTI GLI AGENTI" Click="StopAllAgents_Click" BorderBrush="{StaticResource PaRuXDotWarnBrush}" BorderThickness="2" />
                            <Button Grid.Column="1" Content="Resume automations" loc:Loc.ItContent="Riprendi le automazioni" Click="ResumeAutomations_Click" />
                            <TextBlock x:Name="StopAllStatusText" Grid.Column="2" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Integrations: Developer / AI clients ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Integrations">
                <TextBlock Text="LOCAL AI GATEWAY" loc:Loc.ItText="GATEWAY IA LOCALE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Coding agents and AI apps can use PaRuX's local models instead of a cloud account. PaRuX speaks the Anthropic Messages, OpenAI Responses and OpenAI Chat Completions APIs on a separate loopback-only port that serves models and nothing else. One model instance is shared by every client; PaRuX picks the model for each request." loc:Loc.ItText="Gli agenti di programmazione e le app di IA possono usare i modelli locali di PaRuX invece di un account cloud. PaRuX parla le API Anthropic Messages, OpenAI Responses e OpenAI Chat Completions su una porta separata solo loopback che serve modelli e nient&#x27;altro. Un&#x27;unica istanza del modello è condivisa da tutti i client; PaRuX sceglie il modello per ogni richiesta." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="GatewayStateText" Text="Checking the gateway…" loc:Loc.ItText="Controllo del gateway…" Style="{StaticResource PaRuXBodyStrongTextStyle}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="Settings_Gateway_State_Text" />
                                <TextBlock x:Name="GatewayDetailText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshIntegrations_Click" VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="Settings_Integrations_Refresh_Button" />
                        </Grid>
                        <Expander Header="Advanced gateway settings" loc:Loc.ItHeader="Impostazioni avanzate del gateway" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="{StaticResource PaRuXSpaceS}">
                                <ToggleSwitch x:Name="GatewayEnabledToggle" Header="Gateway port" loc:Loc.ItHeader="Porta del gateway" OnContent="On (loopback only)" loc:Loc.ItOnContent="Attivo (solo loopback)" OffContent="Off" loc:Loc.ItOffContent="Disattivato" />
                                <NumberBox x:Name="GatewayPortBox" Header="Port" loc:Loc.ItHeader="Porta" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" Width="180" HorizontalAlignment="Left" />
                                <ComboBox x:Name="GatewayVendorModelCombo" Header="When a client asks for a Claude or GPT model name, use" loc:Loc.ItHeader="Quando un client chiede il nome di un modello Claude o GPT, usa" Width="320">
                                    <ComboBoxItem Content="parux-auto (PaRuX chooses)" loc:Loc.ItContent="parux-auto (sceglie PaRuX)" Tag="parux-auto" />
                                    <ComboBoxItem Content="parux-code" Tag="parux-code" />
                                    <ComboBoxItem Content="parux-reasoning" Tag="parux-reasoning" />
                                    <ComboBoxItem Content="parux-fast" Tag="parux-fast" />
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXSubtleCaptionStyle}"
                                    Text="Request and response bodies are never written to PaRuX's logs. The gateway never listens on your network; use Privacy &amp; Network for LAN access. Port and on/off changes apply the next time PaRuX starts." loc:Loc.ItText="I corpi di richieste e risposte non vengono mai scritti nei log di PaRuX. Il gateway non resta mai in ascolto sulla tua rete; per l&#x27;accesso LAN usa Privacy e rete. Le modifiche a porta e attivazione si applicano al prossimo avvio di PaRuX." />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                                    <Button Content="Save gateway settings" loc:Loc.ItContent="Salva le impostazioni del gateway" Click="SaveGatewaySettings_Click" />
                                    <TextBlock x:Name="GatewaySettingsStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PaRuXSubtleCaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Integrations">
                <TextBlock Text="DEVELOPER / AI CLIENTS" loc:Loc.ItText="SVILUPPATORI / CLIENT IA" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Connect backs up anything it changes, writes only PaRuX's own entry, and runs a real test in which the client creates a file through PaRuX. Disconnect removes only what PaRuX added; Restore puts the file back exactly as it was before the first Connect." loc:Loc.ItText="Connetti esegue il backup di ciò che modifica, scrive solo la voce di PaRuX ed esegue un test reale in cui il client crea un file tramite PaRuX. Disconnetti rimuove solo ciò che PaRuX ha aggiunto; Ripristina rimette il file esattamente com&#x27;era prima della prima connessione." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Launch in" loc:Loc.ItText="Avvia in" VerticalAlignment="Center" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            <TextBox x:Name="IntegrationWorkingFolderBox" Grid.Column="1" IsReadOnly="True"
                                     AutomationProperties.AutomationId="Settings_Integrations_Folder_Text" AutomationProperties.Name="Integrations folder path" loc:Loc.ItName="Percorso della cartella delle integrazioni" />
                            <Button Grid.Column="2" Content="Choose folder" loc:Loc.ItContent="Scegli la cartella" Click="ChooseIntegrationFolder_Click" />
                        </Grid>
                        <StackPanel x:Name="ClientIntegrationsList" Spacing="{StaticResource PaRuXSpaceS}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Integrations">
                <TextBlock Text="OTHER APPS (GENERIC)" loc:Loc.ItText="ALTRE APP (GENERICHE)" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceS}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Any app that lets you set a custom OpenAI-compatible or Anthropic-compatible endpoint can use PaRuX. Use one of these base URLs, the model parux-auto (or parux-code, parux-reasoning, parux-fast, parux-vision) and a key." loc:Loc.ItText="Qualsiasi app che permetta di impostare un endpoint personalizzato compatibile con OpenAI o Anthropic può usare PaRuX. Usa uno di questi URL di base, il modello parux-auto (o parux-code, parux-reasoning, parux-fast, parux-vision) e una chiave." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}" RowSpacing="{StaticResource PaRuXSpaceXS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="OpenAI-compatible" loc:Loc.ItText="Compatibile con OpenAI" VerticalAlignment="Center" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            <TextBox x:Name="GenericOpenAiUrlText" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" />
                            <Button Grid.Column="2" Content="Copy" loc:Loc.ItContent="Copia" Click="CopyGenericOpenAiUrl_Click" />
                            <TextBlock Grid.Row="1" Text="Anthropic-compatible" loc:Loc.ItText="Compatibile con Anthropic" VerticalAlignment="Center" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            <TextBox x:Name="GenericAnthropicUrlText" Grid.Row="1" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Copy" loc:Loc.ItContent="Copia" Click="CopyGenericAnthropicUrl_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                            <Button Content="Create a key for another app" loc:Loc.ItContent="Crea una chiave per un&#x27;altra app" Click="CreateGenericGatewayKey_Click" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PaRuXSubtleCaptionStyle}"
                                       Text="Keys are listed and revoked under Privacy &amp; Network › API keys." loc:Loc.ItText="Le chiavi sono elencate e revocate in Privacy e rete › Chiavi API." />
                        </StackPanel>
                        <StackPanel x:Name="GenericKeyPanel" Visibility="Collapsed" Spacing="6">
                            <TextBlock Text="Copy this key now — PaRuX keeps only a hash and cannot show it again." loc:Loc.ItText="Copia ora questa chiave: PaRuX ne conserva solo un hash e non può mostrartela di nuovo." TextWrapping="Wrap" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <TextBox x:Name="GenericKeyText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Button Content="Copy key" loc:Loc.ItContent="Copia la chiave" Click="CopyGenericKey_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Gaming & AI Sharing ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Gaming &amp; AI Sharing">
                <TextBlock Text="GAMING &amp; AI RESOURCE SHARING" loc:Loc.ItText="GAMING E CONDIVISIONE DELLE RISORSE IA" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Workload Orchestrator State" loc:Loc.ItText="Stato dell&#x27;orchestratore dei carichi di lavoro" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                Text="Turns your PC into an always-available local AI server that automatically yields GPU/VRAM to local or remote gaming, then recovers resources when gaming finishes." loc:Loc.ItText="Trasforma il PC in un server IA locale sempre disponibile che cede automaticamente GPU/VRAM al gaming locale o remoto e recupera le risorse quando il gioco termina." />
                        </StackPanel>

                        <Border Background="{ThemeResource PaRuXSurfaceSubtleBrush}" CornerRadius="{StaticResource PaRuXRadiusMedium}" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GamingStatusBadge" Grid.Column="0" Text="CHECKING" loc:Loc.ItText="CONTROLLO" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PaRuXDotOkBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GamingStatusMessage" Grid.Column="1" Text="Reading the workload orchestrator state…" loc:Loc.ItText="Lettura dello stato dell&#x27;orchestratore dei carichi di lavoro…" Style="{StaticResource PaRuXCaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="GamingRefreshBtn" AutomationProperties.AutomationId="Settings_Gaming_Refresh_Button" AutomationProperties.Name="Refresh gaming status" loc:Loc.ItName="Aggiorna lo stato Gaming" Grid.Column="2" Content="Refresh Status" loc:Loc.ItContent="Aggiorna lo stato" Click="GamingRefreshBtn_Click" />
                                </Grid>

                                <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,4,0,4" />

                                <Grid ColumnSpacing="16" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="GamingActiveLauncherLabel" Grid.Row="0" Grid.Column="0" Text="Active Launcher: …" loc:Loc.ItText="Launcher attivo: …" Style="{StaticResource PaRuXCaptionTextStyle}" />
                                    <TextBlock x:Name="GamingActiveInputLabel" Grid.Row="0" Grid.Column="1" Text="Active Input: …" loc:Loc.ItText="Input attivo: …" Style="{StaticResource PaRuXCaptionTextStyle}" />
                                    <TextBlock x:Name="GamingVramLabel" Grid.Row="1" Grid.Column="0" Text="VRAM Allocation: …" loc:Loc.ItText="Allocazione VRAM: …" Style="{StaticResource PaRuXCaptionTextStyle}" />
                                    <TextBlock x:Name="GamingSuspendedGameLabel" Grid.Row="1" Grid.Column="1" Text="Suspended Game: …" loc:Loc.ItText="Gioco sospeso: …" Style="{StaticResource PaRuXCaptionTextStyle}" />
                                    <TextBlock x:Name="GamingWorkloadsLabel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="AI Workloads: …" loc:Loc.ItText="Carichi di lavoro IA: …" Style="{StaticResource PaRuXCaptionTextStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="GamingEnterBtn" AutomationProperties.AutomationId="Settings_Gaming_Enter_Button" Content="Enter Gaming" loc:Loc.ItContent="Entra in Gaming" Click="GamingEnterBtn_Click" />
                            <Button x:Name="GamingExitBtn" AutomationProperties.AutomationId="Settings_Gaming_Exit_Button" Content="Return to AI" loc:Loc.ItContent="Torna all&#x27;IA" Click="GamingExitBtn_Click" />
                            <Button x:Name="GamingSuspendBtn" Content="Suspend Game" loc:Loc.ItContent="Sospendi il gioco" Click="GamingSuspendBtn_Click" />
                            <Button x:Name="GamingResumeBtn" Content="Resume Game" loc:Loc.ItContent="Riprendi il gioco" Click="GamingResumeBtn_Click" />
                        </StackPanel>
                        <!-- Shows why a Gaming action was refused or failed; hidden when the last action succeeded. -->
                        <TextBlock x:Name="GamingActionText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Detected Subsystem Providers" loc:Loc.ItText="Sottosistemi rilevati" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="PaRuX automatically detects installed gaming utilities, streaming servers, and suspend tools without requiring third-party cloud services or proprietary home automation dependencies." loc:Loc.ItText="PaRuX rileva automaticamente le utility di gaming, i server di streaming e gli strumenti di sospensione installati, senza richiedere servizi cloud di terze parti né dipendenze di domotica proprietarie." />

                        <StackPanel x:Name="GamingProvidersList" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Gaming Profiles &amp; Quick Resume" loc:Loc.ItText="Profili Gaming e ripresa rapida" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Configure session triggers, launchers, input providers, and Quick Resume (game suspension) policies." loc:Loc.ItText="Configura trigger di sessione, launcher, provider di input e criteri di ripresa rapida (sospensione del gioco)." />

                        <ComboBox x:Name="GamingProfileSelector" Header="Active Profile" loc:Loc.ItHeader="Profilo attivo" HorizontalAlignment="Stretch" SelectionChanged="GamingProfileSelector_SelectionChanged" />
                        <ComboBox x:Name="GamingQuickResumeCombo" Header="Quick Resume Policy" loc:Loc.ItHeader="Criterio di ripresa rapida" HorizontalAlignment="Stretch" SelectionChanged="GamingQuickResumeCombo_SelectionChanged">
                            <ComboBoxItem Content="Auto (Suspend game if compatible, check VRAM)" loc:Loc.ItContent="Auto (sospendi il gioco se compatibile, controlla la VRAM)" Tag="auto" />
                            <ComboBoxItem Content="Always (Suspend game process in RAM)" loc:Loc.ItContent="Sempre (sospendi il processo del gioco in RAM)" Tag="always" />
                            <ComboBoxItem Content="Off (Leave game lifecycle unmanaged)" loc:Loc.ItContent="No (lascia il ciclo di vita del gioco non gestito)" Tag="off" />
                        </ComboBox>

                        <NumberBox x:Name="GamingGracePeriodBox" Header="Remote Reconnect Grace Period (seconds)" loc:Loc.ItHeader="Periodo di tolleranza per la riconnessione remota (secondi)" Minimum="5" Maximum="120" Value="30" SpinButtonPlacementMode="Compact" />
                        <Button x:Name="GamingSaveProfileBtn" Content="Save Profile Settings" loc:Loc.ItContent="Salva le impostazioni del profilo" Click="GamingSaveProfileBtn_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="GamingProfileNoticeText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock x:Name="ConsoleDisplaysHeading" Text="Console / TV display routing" loc:Loc.ItText="Destinazione schermo Console / TV" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <TextBlock x:Name="ConsoleDisplaysIntro" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Choose which Windows screen is a TV and where PaRuX Console fullscreen opens. Other monitors stay available. This moves only the PaRuX window: external games/emulators control their own output. Windows duplicated displays cannot be separated by PaRuX." loc:Loc.ItText="Scegli quale schermo Windows è una TV e dove si apre la Console PaRuX a schermo intero. Gli altri monitor restano disponibili. Sposta solo la finestra di PaRuX: giochi ed emulatori esterni controllano da soli la propria uscita. PaRuX non può separare gli schermi duplicati di Windows." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ConsoleDisplaysRefresh" Content="Detect connected displays" loc:Loc.ItContent="Rileva gli schermi collegati"
                                AutomationProperties.AutomationId="Settings_ConsoleDisplays_Refresh_Button"
                                Click="ConsoleDisplaysRefresh_Click" />
                            <Button x:Name="ConsoleDisplaysUseCurrent" Content="Use current monitor (automatic)" loc:Loc.ItContent="Usa il monitor attuale (automatico)"
                                AutomationProperties.AutomationId="Settings_ConsoleDisplays_Auto_Button"
                                Click="ConsoleDisplaysUseCurrent_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ConsoleDisplaysStatus" TextWrapping="Wrap"
                            AutomationProperties.AutomationId="Settings_ConsoleDisplays_Status_Text"
                            Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <ToggleSwitch x:Name="ConsoleRouteOwnedGamesSwitch"
                            Header="Prefer selected TV for directly launched windowed games" loc:Loc.ItHeader="Preferisci la TV scelta per i giochi in finestra avviati direttamente"
                            AutomationProperties.AutomationId="Settings_ConsoleDisplays_RouteGames_Toggle"
                            IsOn="True" Toggled="ConsoleRouteOwnedGamesSwitch_Toggled" />
                        <ToggleSwitch x:Name="ConsoleAutoReturnHomeSwitch"
                            Header="Show Console Home after a verified game exit (off by default)" loc:Loc.ItHeader="Mostra la Home Console dopo la chiusura verificata del gioco (disattivato di base)"
                            AutomationProperties.AutomationId="Settings_ConsoleDisplays_AutoReturn_Toggle"
                            IsOn="False" Toggled="ConsoleAutoReturnHomeSwitch_Toggled" />
                        <TextBlock x:Name="ConsoleAutoReturnExplanation" TextWrapping="Wrap"
                            Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="When enabled, PaRuX can bring its existing fullscreen Console window forward only after the directly launched game process closes and the Core verifies AI recovery. External launchers and uncertain child processes do not trigger this. Windows may deny foreground activation." loc:Loc.ItText="Se attivo, PaRuX può portare in primo piano la finestra Console a schermo intero già esistente solo dopo la chiusura del processo del gioco avviato direttamente e dopo che il Core ha verificato il ripristino dell&#x27;IA. Launcher esterni e processi figli incerti non attivano questa funzione. Windows può negare l&#x27;attivazione in primo piano." />
                        <StackPanel x:Name="ConsoleDisplaysList" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Automations ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Agents">
                <TextBlock Text="AUTOMATIONS" loc:Loc.ItText="AUTOMAZIONI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="TRIGGER -&gt; CONDITIONS -&gt; ACTION. When the trigger fires, a real Multi-Agent task is created and goes through the same dispatch/execution/verification pipeline as every other task above." loc:Loc.ItText="TRIGGER -&gt; CONDIZIONI -&gt; AZIONE. Quando il trigger scatta, viene creata una vera attività Multi-Agent che segue la stessa pipeline di assegnazione/esecuzione/verifica di ogni altra attività qui sopra." />
                        <TextBox x:Name="AutomationNameBox" PlaceholderText="Name, e.g. 'Daily changelog summary'" loc:Loc.ItPlaceholder="Nome, ad es. &#x27;Riepilogo giornaliero delle modifiche&#x27;" />
                        <ComboBox x:Name="AutomationTriggerTypeBox" Header="Trigger" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Schedule (fixed interval)" loc:Loc.ItContent="Pianificazione (intervallo fisso)" Tag="schedule" />
                            <ComboBoxItem Content="File created in a folder" loc:Loc.ItContent="File creato in una cartella" Tag="file_created" />
                            <ComboBoxItem Content="Git commit in a repository" loc:Loc.ItContent="Commit Git in un repository" Tag="git_commit" />
                        </ComboBox>
                        <NumberBox x:Name="AutomationIntervalSecondsBox" Header="Interval seconds (Schedule trigger)" loc:Loc.ItHeader="Secondi di intervallo (trigger Pianificazione)" Minimum="60" Value="3600" SpinButtonPlacementMode="Compact" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="AutomationFolderPathBox" Grid.Column="0" Header="Folder to watch (File Created) / repository (Git Commit)" loc:Loc.ItHeader="Cartella da monitorare (File creato) / repository (Commit Git)" PlaceholderText="e.g. C:\Users\me\Inbox or C:\Users\me\my-project" loc:Loc.ItPlaceholder="ad es. C:\Users\me\Inbox oppure C:\Users\me\my-project" />
                            <Button Grid.Column="1" Content="Browse…" loc:Loc.ItContent="Sfoglia…" Click="BrowseAutomationFolder_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBox x:Name="AutomationFilterBox" Header="File filter (File Created trigger)" loc:Loc.ItHeader="Filtro dei file (trigger File creato)" PlaceholderText="* (default)" />
                        <TextBox x:Name="AutomationGitBranchBox" Header="Branch (Git Commit trigger, optional)" loc:Loc.ItHeader="Branch (trigger Commit Git, facoltativo)" PlaceholderText="Empty = whatever is currently checked out" loc:Loc.ItPlaceholder="Vuoto = quello attualmente selezionato" />
                        <TextBox x:Name="AutomationGoalTemplateBox" PlaceholderText="Task goal, e.g. 'Summarize {fileName}'" loc:Loc.ItPlaceholder="Obiettivo dell&#x27;attività, ad es. &#x27;Riassumi {fileName}&#x27;" TextWrapping="Wrap" AcceptsReturn="True" />
                        <ComboBox x:Name="AutomationRoleBox" Header="Role (optional - AUTO infers one)" loc:Loc.ItHeader="Ruolo (facoltativo: AUTO ne deduce uno)" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="AUTO" Tag="" />
                            <ComboBoxItem Content="Planner" loc:Loc.ItContent="Pianificatore" Tag="planner" />
                            <ComboBoxItem Content="Research" loc:Loc.ItContent="Ricerca" Tag="research" />
                            <ComboBoxItem Content="Review" loc:Loc.ItContent="Revisione" Tag="review" />
                            <ComboBoxItem Content="Documentation" loc:Loc.ItContent="Documentazione" Tag="documentation" />
                            <ComboBoxItem Content="Testing" loc:Loc.ItContent="Test" Tag="testing" />
                            <ComboBoxItem Content="Security" loc:Loc.ItContent="Sicurezza" Tag="security" />
                        </ComboBox>
                        <Button Content="Create automation" loc:Loc.ItContent="Crea automazione" Click="CreateAutomation_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="AutomationStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutomationsCountLabel" Grid.Column="0" Text="0 automation(s)" loc:Loc.ItText="0 automazioni" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshAutomations_Click" />
                        </Grid>
                        <TextBlock x:Name="AutomationsStatusText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="AutomationsList" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Context Graph Inspector ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Agents">
                <TextBlock Text="CONTEXT GRAPH INSPECTOR" loc:Loc.ItText="ISPETTORE DEL CONTEXT GRAPH" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Entities and relations other vNext features have recorded (projects, tasks, ...) - a small, explainable slice, not a prompt-stuffing dump. Free-form entity/relation types, nothing enforced here." loc:Loc.ItText="Entità e relazioni registrate da altre funzioni vNext (progetti, attività, ...): una piccola porzione spiegabile, non uno scarico per riempire il prompt. Tipi di entità/relazione liberi, qui non viene imposto nulla." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ContextTypeFilterBox" Grid.Column="0" PlaceholderText="Filter by entity type (optional), e.g. 'project'" loc:Loc.ItPlaceholder="Filtra per tipo di entità (facoltativo), ad es. &#x27;project&#x27;" />
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshContextEntities_Click" />
                        </Grid>
                        <TextBlock x:Name="ContextEntitiesCountLabel" Text="0 entities" loc:Loc.ItText="0 entità" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <StackPanel x:Name="ContextEntitiesList" Spacing="8" />
                        <TextBlock Text="Neighborhood" loc:Loc.ItText="Vicinato" Style="{StaticResource PaRuXBodyStrongTextStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="ContextNeighborhoodText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Add an entity or relation manually" loc:Loc.ItText="Aggiungi a mano un&#x27;entità o una relazione" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ContextEntityTypeBox" Grid.Column="0" PlaceholderText="Type, e.g. 'note'" loc:Loc.ItPlaceholder="Tipo, ad es. &#x27;note&#x27;" />
                            <TextBox x:Name="ContextEntityNameBox" Grid.Column="1" PlaceholderText="Name" loc:Loc.ItPlaceholder="Nome" />
                        </Grid>
                        <Button Content="Add entity" loc:Loc.ItContent="Aggiungi entità" Click="CreateContextEntity_Click" HorizontalAlignment="Left" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ContextRelationFromBox" Grid.Column="0" PlaceholderText="From entity id" loc:Loc.ItPlaceholder="ID entità di partenza" />
                            <TextBox x:Name="ContextRelationTypeBox" Grid.Column="1" PlaceholderText="Relation type, e.g. 'RELATES_TO'" loc:Loc.ItPlaceholder="Tipo di relazione, ad es. &#x27;RELATES_TO&#x27;" />
                            <TextBox x:Name="ContextRelationToBox" Grid.Column="2" PlaceholderText="To entity id" loc:Loc.ItPlaceholder="ID entità di arrivo" />
                        </Grid>
                        <Button Content="Add relation" loc:Loc.ItContent="Aggiungi relazione" Click="CreateContextRelation_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ContextGraphStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== PaRuX Platform / Universal Diff ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="PaRuX Platform">
                <TextBlock Text="LICENSE &amp; TRUST" loc:Loc.ItText="LICENZA E AFFIDABILITÀ" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Inspect license metadata declared by a Hugging Face model or dataset repository. PaRuX reports the source metadata as-is; absence is not permission, and this is not legal advice." loc:Loc.ItText="Ispeziona i metadati di licenza dichiarati da un repository di modelli o dataset di Hugging Face. PaRuX riporta i metadati di origine così come sono; l&#x27;assenza non è un permesso e questa non è una consulenza legale." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="LicenseTrustKindBox" Grid.Column="0" Header="Repository kind" loc:Loc.ItHeader="Tipo di repository" SelectedIndex="0">
                                <ComboBoxItem Content="Model" loc:Loc.ItContent="Modello" Tag="model" />
                                <ComboBoxItem Content="Dataset" Tag="dataset" />
                            </ComboBox>
                            <TextBox x:Name="LicenseTrustRepoIdBox" Grid.Column="1" Header="Hugging Face repository" loc:Loc.ItHeader="Repository Hugging Face" PlaceholderText="owner/repository" loc:Loc.ItPlaceholder="proprietario/repository" />
                            <Button x:Name="LicenseTrustInspectButton" Grid.Column="2" Content="Inspect metadata" loc:Loc.ItContent="Ispeziona i metadati" Click="InspectLicenseTrust_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock x:Name="LicenseTrustStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBlock x:Name="LicenseTrustResultText" TextWrapping="Wrap" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="OBSERVABILITY" loc:Loc.ItText="OSSERVABILITÀ" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="A read-only chronological view over real records already owned by agent tasks, model and dataset downloads, training jobs, adapters, and AutoLab experiments. Refreshing does not create or modify data." loc:Loc.ItText="Una vista cronologica di sola lettura sui record reali già posseduti da attività degli agenti, download di modelli e dataset, job di training, adapter ed esperimenti AutoLab. L&#x27;aggiornamento non crea né modifica dati." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ObservabilityCountText" Grid.Column="0" Text="Timeline not loaded" loc:Loc.ItText="Timeline non caricata" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button x:Name="ObservabilityRefreshButton" Grid.Column="1" Content="Refresh latest 50" loc:Loc.ItContent="Aggiorna gli ultimi 50" Click="RefreshObservability_Click" />
                        </Grid>
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ObservabilityTimelineList" Spacing="8" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <TextBlock Text="CAPABILITY PROFILER" loc:Loc.ItText="PROFILATORE DELLE CAPACITÀ" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Runs a fixed battery of five real probes (JSON reliability, exact instruction-following, math reasoning, moderate long-context recall, tool-call formatting) against whichever model is currently loaded and healthy in the text runtime. Deterministically scored - no second model judges the answers." loc:Loc.ItText="Esegue una batteria fissa di cinque prove reali (affidabilità JSON, rispetto esatto delle istruzioni, ragionamento matematico, richiamo di contesto lungo moderato, formattazione delle chiamate a strumenti) sul modello attualmente caricato e funzionante nel runtime di testo. Punteggio deterministico: nessun secondo modello giudica le risposte." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CapabilityProfilerStatusText" Grid.Column="0" Text="No profile run yet." loc:Loc.ItText="Nessuna esecuzione del profilo ancora." Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="CapabilityProfilerRunButton" Grid.Column="1" Content="Run profile" loc:Loc.ItContent="Esegui il profilo" Click="RunCapabilityProfile_Click" />
                        </Grid>
                        <StackPanel x:Name="CapabilityProfilerResultsList" Spacing="6" />
                    </StackPanel>
                </Border>

                <TextBlock Text="UNIVERSAL DIFF" loc:Loc.ItText="DIFF UNIVERSALE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Compare any two text-shaped values locally: code, configuration, prompts, skill manifests, or exported document text. PaRuX Core performs a line-level comparison; no model or internet connection is used." loc:Loc.ItText="Confronta in locale due valori qualsiasi in forma di testo: codice, configurazione, prompt, manifest di skill o testo di documenti esportati. PaRuX Core esegue un confronto riga per riga; non vengono usati modelli né connessione a Internet." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UniversalDiffOldTextBox" Grid.Column="0" Header="Original text" loc:Loc.ItHeader="Testo originale"
                                     PlaceholderText="Paste the original text" loc:Loc.ItPlaceholder="Incolla il testo originale" AcceptsReturn="True" TextWrapping="NoWrap"
                                     MinHeight="220" FontFamily="Consolas"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBox x:Name="UniversalDiffNewTextBox" Grid.Column="1" Header="Updated text" loc:Loc.ItHeader="Testo aggiornato"
                                     PlaceholderText="Paste the updated text" loc:Loc.ItPlaceholder="Incolla il testo aggiornato" AcceptsReturn="True" TextWrapping="NoWrap"
                                     MinHeight="220" FontFamily="Consolas"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                            <Button x:Name="UniversalDiffCompareButton" Content="Compare" loc:Loc.ItContent="Confronta" Click="CompareUniversalDiff_Click" />
                            <Button Content="Clear" loc:Loc.ItContent="Cancella" Click="ClearUniversalDiff_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UniversalDiffStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBox x:Name="UniversalDiffOutputBox" Header="Diff result" loc:Loc.ItHeader="Risultato del diff" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180" MaxHeight="420"
                                 FontFamily="Consolas" PlaceholderText="Lines prefixed with + were added; lines prefixed with - were removed." loc:Loc.ItPlaceholder="Le righe precedute da + sono state aggiunte; quelle precedute da - sono state rimosse."
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Storage ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Data">
                <TextBlock Text="STORAGE" loc:Loc.ItText="ARCHIVIAZIONE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel>
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Managed-data quota" loc:Loc.ItText="Quota dei dati gestiti" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="StorageUsageText" Text="Calculating local usage…" loc:Loc.ItText="Calcolo dell&#x27;utilizzo locale…" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="StorageQuotaBox" Grid.Column="1" Header="GB" Minimum="10" Maximum="400" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="StorageQuotaNumber_ValueChanged" />
                            <Button Grid.Column="2" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshStorage_Click" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </Grid>
                        <StackPanel x:Name="StorageBreakdownList" Spacing="4" Margin="0,10,0,0" />
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,10,0,10" />
                        <TextBlock x:Name="AiStorageBudgetText" Style="{StaticResource PaRuXBodyStrongTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Whole-ecosystem total (PaRuX's own data plus the external LLM model stack above), advisory only — nothing is deleted automatically." loc:Loc.ItText="Totale dell&#x27;intero ecosistema (i dati di PaRuX più lo stack di modelli LLM esterno qui sopra), solo indicativo: nulla viene eliminato automaticamente."
                                   Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,12,0,12" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Document attachments" loc:Loc.ItText="Allegati di documenti" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock Text="PDF, DOCX, PPTX, XLS/XLSX/XLSB, CSV/TSV, text, source code, JSON and XML. PDFs are analyzed as page images." loc:Loc.ItText="PDF, DOCX, PPTX, XLS/XLSX/XLSB, CSV/TSV, testo, codice sorgente, JSON e XML. I PDF vengono analizzati come immagini di pagina." TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <NumberBox x:Name="MaxDocumentsBox" Grid.Column="1" Header="Files" loc:Loc.ItHeader="File" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" ValueChanged="DocumentNumberBox_ValueChanged" />
                            <NumberBox x:Name="MaxDocumentMegabytesBox" Grid.Column="2" Header="MB each" loc:Loc.ItHeader="MB ciascuno" Minimum="1" Maximum="1024" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="DocumentNumberBox_ValueChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Internet ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Privacy &amp; Network">
                <TextBlock Text="INTERNET" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Web search" loc:Loc.ItText="Ricerca sul web" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                                Text="Off by default. When on, an explicit request like 'search the web for…' runs one keyless search and reads the top results — never automatically, and never as a fallback for the AI itself. AI inference always stays local; nothing here sends a prompt to a cloud AI provider. Page content is always treated as untrusted data, never as instructions." loc:Loc.ItText="Disattivata di default. Se attiva, una richiesta esplicita come &#x27;cerca sul web…&#x27; esegue una ricerca senza chiave e legge i primi risultati: mai in automatico e mai come ripiego per l&#x27;IA stessa. L&#x27;inferenza IA resta sempre locale; nulla qui invia un prompt a un provider di IA cloud. Il contenuto delle pagine è sempre trattato come dato non attendibile, mai come istruzione." />
                            <TextBlock x:Name="InternetStatusText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="InternetSwitch" Grid.Column="1"
                                      OffContent="Off" loc:Loc.ItOffContent="Disattivato" OnContent="On" VerticalAlignment="Center"
                                      Toggled="InternetSwitch_Toggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== RAG ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Chat Behavior">
                <TextBlock Text="RAG (LOCAL DOCUMENTS)" loc:Loc.ItText="RAG (DOCUMENTI LOCALI)" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Index a folder and PaRuX retrieves relevant excerpts into chat automatically, with the source file and page, sheet or slide named in the reply. PDF, Office, text, code, e-mail and many other formats are indexed; anything unreadable is still findable by name. Folders with credentials or private application data are refused." loc:Loc.ItText="Indicizza una cartella e PaRuX recupera automaticamente nella chat gli estratti rilevanti, indicando nella risposta il file di origine e la pagina, il foglio o la diapositiva. Vengono indicizzati PDF, Office, testo, codice, e-mail e molti altri formati; ciò che non è leggibile resta comunque trovabile per nome. Le cartelle con credenziali o dati privati di applicazioni vengono rifiutate." />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Semantic search engine" loc:Loc.ItText="Motore di ricerca semantica" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="EmbeddingEngineStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <Button x:Name="InstallEmbeddingEngineButton" Grid.Column="1" Content="Install (~90 MB)" loc:Loc.ItContent="Installa (~90 MB)" Click="InstallEmbeddingEngine_Click" />
                        </Grid>

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Indexed folders" loc:Loc.ItText="Cartelle indicizzate" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Add folder…" loc:Loc.ItContent="Aggiungi cartella…" Click="AddRagSource_Click" />
                        </Grid>
                        <StackPanel x:Name="RagSourcesList" Spacing="6" />
                        <TextBlock x:Name="RagIndexStatus" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="KnowledgeSettingsPanel" Spacing="{StaticResource PaRuXSpaceS}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Personas ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Chat Behavior">
                <TextBlock Text="PERSONAS" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="A system-prompt preset that shapes tone and personality - layered on top of whatever the current route/skill already needs, so it never replaces PaRuX's actual capabilities. Applies to every device, same as Memory and RAG." loc:Loc.ItText="Un preset di istruzioni di sistema che dà forma a tono e personalità, sovrapposto a ciò che la route o la skill corrente già richiede, quindi non sostituisce mai le capacità reali di PaRuX. Vale per tutti i dispositivi, come Memoria e RAG." />
                        <StackPanel x:Name="PersonasList" Spacing="6" />

                        <TextBlock Text="Create a custom persona" loc:Loc.ItText="Crea una persona personalizzata" Style="{StaticResource PaRuXBodyStrongTextStyle}" Margin="0,4,0,0" />
                        <TextBox x:Name="NewPersonaNameBox" PlaceholderText="Name, e.g. Sarcastic Reviewer" loc:Loc.ItPlaceholder="Nome, ad es. Revisore sarcastico" />
                        <TextBox x:Name="NewPersonaPromptBox" PlaceholderText="System-prompt instruction, e.g. Respond with dry, sarcastic wit while still being accurate." loc:Loc.ItPlaceholder="Istruzione di sistema, ad es. Rispondi con arguzia secca e sarcastica restando accurato."
                            TextWrapping="Wrap" AcceptsReturn="True" Height="72" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create persona" loc:Loc.ItContent="Crea persona" HorizontalAlignment="Left" Click="CreatePersona_Click" />
                            <Button x:Name="ImportPersonaCardButton" Content="Import character card…" loc:Loc.ItContent="Importa scheda personaggio…" AutomationProperties.AutomationId="Settings_Persona_ImportCard_Button" Click="ImportPersonaCard_Click" />
                        </StackPanel>
                        <TextBlock x:Name="PersonaStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Memory ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Chat Behavior">
                <TextBlock Text="MEMORY" loc:Loc.ItText="MEMORIA" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Persistent local facts PaRuX can selectively recall in chat — never the whole list, just what's relevant to what you just asked. Stays on this PC; nothing here is sent anywhere except as short snippets inside your own prompts to your own local model." loc:Loc.ItText="Fatti locali persistenti che PaRuX può richiamare selettivamente in chat: mai l&#x27;intero elenco, solo ciò che è pertinente a quanto hai appena chiesto. Restano su questo PC; nulla viene inviato altrove, se non come brevi frammenti dentro i tuoi prompt al tuo modello locale." />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MemoryScopeCombo" AutomationProperties.Name="Memory scope" loc:Loc.ItName="Ambito della memoria" Grid.Column="0" SelectedIndex="0">
                                <ComboBoxItem Content="User" loc:Loc.ItContent="Utente" Tag="User" />
                                <ComboBoxItem Content="Project" loc:Loc.ItContent="Progetto" Tag="Project" />
                                <ComboBoxItem Content="Conversation" loc:Loc.ItContent="Conversazione" Tag="Conversation" />
                                <ComboBoxItem Content="Agent" loc:Loc.ItContent="Agente" Tag="Agent" />
                            </ComboBox>
                            <TextBox x:Name="MemoryNewContentBox" Grid.Column="1" PlaceholderText="Add a memory, e.g. I prefer terse commit messages" loc:Loc.ItPlaceholder="Aggiungi un ricordo, ad es. Preferisco messaggi di commit concisi" />
                            <Button Grid.Column="2" Content="Add" loc:Loc.ItContent="Aggiungi" Click="AddMemory_Click" />
                        </Grid>

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MemorySearchBox" Grid.Column="0" PlaceholderText="Search memory…" loc:Loc.ItPlaceholder="Cerca nella memoria…" TextChanged="MemorySearchBox_TextChanged" />
                            <Button Grid.Column="1" Content="Export" loc:Loc.ItContent="Esporta" Click="ExportMemory_Click" />
                            <Button Grid.Column="2" Content="Import" loc:Loc.ItContent="Importa" Click="ImportMemory_Click" />
                            <Button Grid.Column="3" Content="Clear all" loc:Loc.ItContent="Cancella tutto" Click="ClearMemory_Click" />
                        </Grid>

                        <TextBlock x:Name="MemoryStatusText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="MemoryList" Spacing="6" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Backup & Restore ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Data">
                <TextBlock Text="BACKUP &amp; RESTORE" loc:Loc.ItText="BACKUP E RIPRISTINO" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Save everything PaRuX considers your own data - conversation history, Memory, indexed-folder configuration, and app settings - into one .zip file, and restore it later on this PC or a new one. Downloaded AI models and the contents of indexed folders are never included; re-indexing after a restore is fine." loc:Loc.ItText="Salva tutto ciò che PaRuX considera dati tuoi (cronologia delle conversazioni, Memoria, configurazione delle cartelle indicizzate e impostazioni dell&#x27;app) in un unico file .zip e ripristinalo in seguito su questo PC o su uno nuovo. I modelli IA scaricati e il contenuto delle cartelle indicizzate non sono mai inclusi; dopo un ripristino va bene reindicizzare." />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Export backup…" loc:Loc.ItContent="Esporta il backup…" Click="ExportBackup_Click" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Content="Clear safety snapshots" loc:Loc.ItContent="Cancella gli snapshot di sicurezza" Click="ClearSafetySnapshots_Click"
                                    ToolTipService.ToolTip="Deletes the automatic pre-restore copies PaRuX keeps under its data folder (backups). They contain your full data." loc:Loc.ItToolTip="Elimina le copie automatiche pre-ripristino che PaRuX conserva nella sua cartella dati (backups). Contengono tutti i tuoi dati." />
                            <Button Grid.Column="2" Content="Import backup…" loc:Loc.ItContent="Importa il backup…" Click="ImportBackup_Click" />
                        </Grid>

                        <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Import chat history ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Data">
                <TextBlock Text="IMPORT CHAT HISTORY" loc:Loc.ItText="IMPORTA CRONOLOGIA CHAT" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Bring conversations in from a ChatGPT or Claude data export (.zip or conversations.json) or a Google Takeout Gemini MyActivity.json. Imported as ordinary local conversations tagged with their source; importing the same file again skips what is already there." loc:Loc.ItText="Importa conversazioni da un&#x27;esportazione dati di ChatGPT o Claude (.zip o conversations.json) o da un MyActivity.json di Gemini di Google Takeout. Vengono importate come normali conversazioni locali con l&#x27;etichetta della fonte; importare di nuovo lo stesso file salta ciò che c&#x27;è già." />
                        <Button Content="Import chats…" loc:Loc.ItContent="Importa chat…" AutomationProperties.AutomationId="Import_Chats_Button" Click="ImportChatHistory_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ChatImportStatus" AutomationProperties.AutomationId="Import_Chats_Status" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Button Content="Find models from other apps…" loc:Loc.ItContent="Trova modelli di altre app…" AutomationProperties.AutomationId="ExternalModels_Find_Button" Click="FindModelsFromOtherApps_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ExternalModelsStatus" AutomationProperties.AutomationId="ExternalModels_Status" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Skills ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Chat Behavior">
                <TextBlock Text="SKILLS" loc:Loc.ItText="SKILL" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Every capability PaRuX can run - what model role it prefers, which tools and policies it uses, and its permissions - fully inspectable, nothing hidden. AUTO picks one by trigger phrase; force one from the composer's skill selector or a slash command." loc:Loc.ItText="Ogni capacità che PaRuX può eseguire: quale ruolo di modello preferisce, quali strumenti e criteri usa e i suoi permessi, tutto ispezionabile e nulla di nascosto. AUTO ne sceglie una in base alla frase di attivazione; forzane una dal selettore skill del compositore o con un comando slash." />

                        <Button Content="What are Skills? (guide)" loc:Loc.ItContent="Cosa sono le skill? (guida)" HorizontalAlignment="Left" Click="SkillsGuide_Click" />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SkillsCountLabel" Text="Loading skills…" loc:Loc.ItText="Caricamento delle skill…" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="New skill…" loc:Loc.ItContent="Nuova skill…" Click="CreateSkill_Click" />
                            <Button Grid.Column="2" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshSkills_Click" />
                        </Grid>
                        <TextBlock x:Name="SkillsStatusText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="SkillsList" Spacing="6" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Research ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Automation">
                <TextBlock Text="RESEARCH" loc:Loc.ItText="RICERCA" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Plans queries, searches the web, fetches sources, and synthesizes a cited local-model answer. Requires Internet enabled above. Fast = one pass; Deep is the most thorough." loc:Loc.ItText="Pianifica le query, cerca sul web, recupera le fonti e sintetizza una risposta citata con il modello locale. Richiede Internet attivo qui sopra. Veloce = un solo passaggio; Approfondita è la più completa." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ResearchModeCombo" AutomationProperties.Name="Research mode" loc:Loc.ItName="Modalità di ricerca" Grid.Column="0" SelectedIndex="1">
                                <ComboBoxItem Content="Fast" loc:Loc.ItContent="Veloce" Tag="fast" />
                                <ComboBoxItem Content="Balanced" loc:Loc.ItContent="Bilanciata" Tag="balanced" />
                                <ComboBoxItem Content="Deep" loc:Loc.ItContent="Approfondita" Tag="deep" />
                            </ComboBox>
                            <TextBox x:Name="ResearchQuestionBox" Grid.Column="1" PlaceholderText="Ask a research question…" loc:Loc.ItPlaceholder="Fai una domanda di ricerca…" AcceptsReturn="False" />
                            <Button x:Name="ResearchAskButton" Grid.Column="2" Content="Ask" loc:Loc.ItContent="Chiedi" Click="ResearchAsk_Click" />
                        </Grid>
                        <ProgressRing x:Name="ResearchProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                        <TextBlock x:Name="ResearchAnswer" TextWrapping="Wrap" Style="{StaticResource PaRuXBodyTextStyle}" Visibility="Collapsed" />
                        <StackPanel x:Name="ResearchSourcesList" Spacing="4" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Presentations ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="PRESENTATIONS" loc:Loc.ItText="PRESENTAZIONI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Local-LLM outline plus native OpenXml slide construction - a real, editable .pptx file, no external service." loc:Loc.ItText="Scaletta con LLM locale più costruzione nativa delle diapositive con OpenXml: un vero file .pptx modificabile, senza servizi esterni." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PresentationTopicBox" Grid.Column="0" PlaceholderText="Presentation topic…" loc:Loc.ItPlaceholder="Argomento della presentazione…" />
                            <NumberBox x:Name="PresentationSlideCount" Grid.Column="1" Value="6" Minimum="2" Maximum="30" SpinButtonPlacementMode="Compact" />
                            <Button x:Name="PresentationGenerateButton" Grid.Column="2" Content="Generate" loc:Loc.ItContent="Genera" Click="PresentationGenerate_Click" />
                        </Grid>
                        <ProgressRing x:Name="PresentationProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                        <StackPanel x:Name="PresentationSlidesList" Spacing="4" />
                        <Button x:Name="PresentationSaveButton" Content="Save .pptx…" loc:Loc.ItContent="Salva .pptx…" Visibility="Collapsed" Click="PresentationSave_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Speech ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="SPEECH" loc:Loc.ItText="VOCE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock x:Name="SpeechEngineStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" Text="Checking speech engines…" loc:Loc.ItText="Controllo dei motori vocali…" />

                        <TextBlock Text="Text to speech" loc:Loc.ItText="Sintesi vocale" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="TtsTextBox" Grid.Column="0" PlaceholderText="Text to speak…" loc:Loc.ItPlaceholder="Testo da pronunciare…" AcceptsReturn="True" MaxHeight="80" TextWrapping="Wrap" />
                            <Button x:Name="TtsSpeakButton" Grid.Column="1" Content="Speak" loc:Loc.ItContent="Pronuncia" Click="TtsSpeak_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <MediaPlayerElement x:Name="TtsPlayer" Height="0" Visibility="Collapsed" AreTransportControlsEnabled="False" />
                        <TextBlock x:Name="TtsStatus" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />

                        <TextBlock Text="Speech to text" loc:Loc.ItText="Riconoscimento vocale" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Transcribe an audio file (wav/mp3)" loc:Loc.ItText="Trascrivi un file audio (wav/mp3)" Style="{StaticResource PaRuXBodyTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="SttPickButton" Content="Pick audio…" loc:Loc.ItContent="Scegli l&#x27;audio…" Click="SttPick_Click" />
                        </Grid>
                        <TextBlock x:Name="SttResult" TextWrapping="Wrap" Style="{StaticResource PaRuXBodyTextStyle}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Local AI runtime location ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="LOCAL AI RUNTIME LOCATION" loc:Loc.ItText="POSIZIONE DEL RUNTIME IA LOCALE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Where the local AI runtime lives on disk (llama.cpp builds, ComfyUI, models, config, logs). PaRuX auto-detects an existing installation; only change this if you moved it or are setting up a fresh machine." loc:Loc.ItText="Dove si trova su disco il runtime IA locale (build di llama.cpp, ComfyUI, modelli, configurazione, log). PaRuX rileva da solo un&#x27;installazione esistente; cambia questo valore solo se l&#x27;hai spostata o se stai configurando una macchina nuova." />
                        <TextBlock x:Name="LocalAiRootText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalAiRootBox" Grid.Column="0" PlaceholderText="Local AI root folder" loc:Loc.ItPlaceholder="Cartella radice dell&#x27;IA locale" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse…" loc:Loc.ItContent="Sfoglia…" Click="LocalAiRootBrowse_Click" />
                            <Button Grid.Column="2" Content="Save" loc:Loc.ItContent="Salva" Click="LocalAiRootSave_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Local AI runtime components & lifecycle ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <Grid Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RUNTIME COMPONENTS &amp; LIFECYCLE" loc:Loc.ItText="COMPONENTI E CICLO DI VITA DEL RUNTIME" Style="{StaticResource PaRuXSectionHeaderTextStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="RefreshComponentsSettingsButton" AutomationProperties.AutomationId="Settings_RefreshComponents_Button" Content="Refresh components" loc:Loc.ItContent="Aggiorna i componenti" Click="RefreshComponentsSettings_Click" FontSize="12" />
                </Grid>
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Local-first component lifecycle. You can detect, locate existing, install with PaRuX, or skip components at any time. PaRuX never alters user-managed software without explicit direction." loc:Loc.ItText="Ciclo di vita dei componenti local-first. Puoi rilevare, individuare quelli esistenti, installare con PaRuX o saltare i componenti in qualsiasi momento. PaRuX non modifica mai il software gestito dall&#x27;utente senza una tua indicazione esplicita." />
                        <ProgressBar x:Name="ComponentsSettingsProgress" AutomationProperties.AutomationId="Settings_Components_Progress" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="ComponentsSettingsStatusText" AutomationProperties.AutomationId="Settings_Components_StatusText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="ComponentsSettingsList" AutomationProperties.AutomationId="Settings_Components_List" Spacing="{StaticResource PaRuXSpaceS}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Model Downloads ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="MODEL DOWNLOADS" loc:Loc.ItText="DOWNLOAD DEI MODELLI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Search Hugging Face for GGUF models and download straight into PaRuX's managed folder, checked against the AI storage budget before every download. This never touches the external LocalAI model stack - point a runtime at a downloaded file yourself when you want to use it." loc:Loc.ItText="Cerca su Hugging Face modelli GGUF e scaricali direttamente nella cartella gestita da PaRuX, con verifica del budget di archiviazione IA prima di ogni download. Non tocca mai lo stack di modelli LocalAI esterno: punta tu stesso un runtime a un file scaricato quando vuoi usarlo." />
                        <TextBlock x:Name="ModelBudgetText" Style="{StaticResource PaRuXCaptionTextStyle}" />

                        <TextBlock Text="Recommended models" loc:Loc.ItText="Modelli consigliati" Style="{StaticResource PaRuXBodyStrongTextStyle}" Margin="0,8,0,0" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Not sure what to download? These are current, well-regarded models for common use cases, rated against your own hardware." loc:Loc.ItText="Non sai cosa scaricare? Ecco modelli attuali e apprezzati per i casi d&#x27;uso più comuni, valutati sul tuo hardware." />
                        <StackPanel x:Name="RecommendedModelsList" Spacing="8" />

                        <TextBlock Text="Search Hugging Face" loc:Loc.ItText="Cerca su Hugging Face" Style="{StaticResource PaRuXBodyStrongTextStyle}" Margin="0,8,0,0" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelSearchBox" Grid.Column="0" PlaceholderText="Search Hugging Face for GGUF models…" loc:Loc.ItPlaceholder="Cerca modelli GGUF su Hugging Face…" />
                            <Button Grid.Column="1" Content="Search" loc:Loc.ItContent="Cerca" Click="ModelSearch_Click" />
                        </Grid>
                        <ProgressRing x:Name="ModelSearchProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                        <StackPanel x:Name="ModelSearchResults" Spacing="8" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PaRuX managed model library" loc:Loc.ItText="Libreria di modelli gestita da PaRuX" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshManagedModels_Click" />
                                <Button Content="Unload" loc:Loc.ItContent="Scarica dalla memoria" Click="UnloadManagedModel_Click" ToolTipService.ToolTip="Stops whichever role is currently loaded into the text runtime." loc:Loc.ItToolTip="Ferma il ruolo attualmente caricato nel runtime di testo." />
                            </StackPanel>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Only files downloaded or explicitly copied into PaRuX's managed folder appear here. Delete is restricted to this folder and never touches the external LocalAI stack. Pick a role and Load to actually start this file in the text runtime - only one role can be loaded at a time on this machine." loc:Loc.ItText="Qui compaiono solo i file scaricati o copiati esplicitamente nella cartella gestita da PaRuX. Elimina è limitato a questa cartella e non tocca mai lo stack LocalAI esterno. Scegli un ruolo e premi Carica per avviare davvero questo file nel runtime di testo: su questa macchina si può caricare un solo ruolo alla volta." />
                        <TextBlock x:Name="RuntimeManagerStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel x:Name="ManagedModelsList" Spacing="6" />
                        <TextBlock Text="Active downloads" loc:Loc.ItText="Download attivi" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                        <StackPanel x:Name="ModelDownloadsList" Spacing="6" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Installed model benchmarks" loc:Loc.ItText="Benchmark dei modelli installati" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna" Click="RefreshModelBenchmarks_Click" />
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Every completed GGUF download is benchmarked automatically. Run it again at any time here. Averages only combine measurements from the same backend and hardware." loc:Loc.ItText="Ogni download GGUF completato viene misurato automaticamente. Puoi rieseguire la misura qui in qualsiasi momento. Le medie combinano solo misure dello stesso backend e hardware." />
                        <StackPanel x:Name="ModelBenchmarksList" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Model Compare ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="MODEL COMPARE" loc:Loc.ItText="CONFRONTO DEI MODELLI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Blind side-by-side test: send one prompt to two local models, one after another (this GPU can't hold two large models loaded at once), then compare the replies before finding out which model said what." loc:Loc.ItText="Test alla cieca affiancato: invia un prompt a due modelli locali, uno dopo l&#x27;altro (questa GPU non regge due modelli grandi caricati insieme), poi confronta le risposte prima di scoprire quale modello ha detto cosa." />
                        <TextBox x:Name="ComparePromptBox" PlaceholderText="Prompt to send to both models…" loc:Loc.ItPlaceholder="Prompt da inviare a entrambi i modelli…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CompareModelACombo" AutomationProperties.Name="Compare model A" loc:Loc.ItName="Confronta il modello A" Grid.Column="0" PlaceholderText="Model A" loc:Loc.ItPlaceholder="Modello A" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="CompareModelBCombo" AutomationProperties.Name="Compare model B" loc:Loc.ItName="Confronta il modello B" Grid.Column="1" PlaceholderText="Model B" loc:Loc.ItPlaceholder="Modello B" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Button x:Name="CompareRunButton" Content="Run comparison" loc:Loc.ItContent="Esegui il confronto" Click="CompareRun_Click" HorizontalAlignment="Left" />
                        <Button x:Name="CompareCancelButton" Content="Cancel run" loc:Loc.ItContent="Annulla l&#x27;esecuzione" Visibility="Collapsed" Click="CompareCancel_Click" HorizontalAlignment="Left" />
                        <ProgressRing x:Name="CompareProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                        <TextBlock x:Name="CompareStageText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />

                        <Grid x:Name="CompareResultsGrid" ColumnSpacing="{StaticResource PaRuXSpaceM}" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="CompareALabel" Text="Response A" loc:Loc.ItText="Risposta A" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="CompareAText" TextWrapping="Wrap" Style="{StaticResource PaRuXBodyTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="CompareBLabel" Text="Response B" loc:Loc.ItText="Risposta B" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="CompareBText" TextWrapping="Wrap" Style="{StaticResource PaRuXBodyTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="CompareRevealButton" Content="Reveal" loc:Loc.ItContent="Rivela" Click="CompareReveal_Click" HorizontalAlignment="Left" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Group Chat ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="GROUP CHAT" loc:Loc.ItText="CHAT DI GRUPPO" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="2-4 local models take turns replying to one prompt, each seeing what the others already said - one model loaded at a time, in order (this GPU can't hold more than one large model at once)." loc:Loc.ItText="Da 2 a 4 modelli locali rispondono a turno a un prompt, ciascuno vedendo ciò che hanno già detto gli altri: un solo modello caricato alla volta, in ordine (questa GPU non regge più di un modello grande alla volta)." />
                        <TextBox x:Name="GroupChatPromptBox" PlaceholderText="Prompt for the group…" loc:Loc.ItPlaceholder="Prompt per il gruppo…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" MaxLength="12000" />
                        <TextBox x:Name="GroupChatSharedContextBox"
                            AutomationProperties.AutomationId="Settings_GroupChat_SharedContext_TextBox"
                            AutomationProperties.Name="Optional context shared with every local model" loc:Loc.ItName="Contesto facoltativo condiviso con ogni modello locale"
                            Header="Shared notes or reference text (optional)" loc:Loc.ItHeader="Note condivise o testo di riferimento (facoltativo)"
                            PlaceholderText="Paste only the relevant context you want each local model to see" loc:Loc.ItPlaceholder="Incolla solo il contesto pertinente che vuoi far vedere a ciascun modello locale"
                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                            MaxLength="12000" />
                        <TextBlock x:Name="GroupChatSharedContextHint"
                            Text="Only the text you paste above is shared with all selected local models. Other conversations, memory and files are not included automatically." loc:Loc.ItText="Solo il testo incollato qui sopra è condiviso con tutti i modelli locali selezionati. Altre conversazioni, memoria e file non sono inclusi automaticamente."
                            TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}" RowSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <ComboBox x:Name="GroupChatModel1Combo" AutomationProperties.Name="Group chat participant 1" loc:Loc.ItName="Partecipante 1 della chat di gruppo" Grid.Row="0" Grid.Column="0" PlaceholderText="Participant 1" loc:Loc.ItPlaceholder="Partecipante 1" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="GroupChatModel2Combo" AutomationProperties.Name="Group chat participant 2" loc:Loc.ItName="Partecipante 2 della chat di gruppo" Grid.Row="0" Grid.Column="1" PlaceholderText="Participant 2" loc:Loc.ItPlaceholder="Partecipante 2" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="GroupChatModel3Combo" AutomationProperties.Name="Group chat participant 3" loc:Loc.ItName="Partecipante 3 della chat di gruppo" Grid.Row="1" Grid.Column="0" PlaceholderText="Participant 3 (optional)" loc:Loc.ItPlaceholder="Partecipante 3 (facoltativo)" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="GroupChatModel4Combo" AutomationProperties.Name="Group chat participant 4" loc:Loc.ItName="Partecipante 4 della chat di gruppo" Grid.Row="1" Grid.Column="1" PlaceholderText="Participant 4 (optional)" loc:Loc.ItPlaceholder="Partecipante 4 (facoltativo)" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Button x:Name="GroupChatRunButton" Content="Start group chat" loc:Loc.ItContent="Avvia la chat di gruppo" Click="GroupChatRun_Click" HorizontalAlignment="Left" />
                        <Button x:Name="GroupChatCancelButton" Content="Cancel group chat" loc:Loc.ItContent="Annulla la chat di gruppo" Visibility="Collapsed" Click="GroupChatCancel_Click" HorizontalAlignment="Left" />
                        <ProgressRing x:Name="GroupChatProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                        <TextBlock x:Name="GroupChatStageText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="GroupChatResultsList" Spacing="{StaticResource PaRuXSpaceM}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Candidate Discovery Policy ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="CANDIDATE DISCOVERY POLICY" loc:Loc.ItText="CRITERI DI SCOPERTA DEI CANDIDATI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="Choose how PaRuX treats newly discovered model candidates. The notice list in Model Hub already offers Evaluate, Later and Ignore per candidate." loc:Loc.ItText="Scegli come PaRuX tratta i nuovi modelli candidati scoperti. L&#x27;elenco degli avvisi in Model Hub offre già Valuta, Più tardi e Ignora per ogni candidato."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />

                        <!-- Row 1: Automatic evaluation -->
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DiscoveryPolicyAutoEvaluateLabel"
                                           Text="Evaluate suitable models automatically" loc:Loc.ItText="Valuta automaticamente i modelli adatti"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="DiscoveryPolicyAutoEvaluateExplanation"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="Settings_DiscoveryPolicy_AutoEvaluate_Toggle"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="Settings_DiscoveryPolicy_AutoEvaluate_Toggle"
                                          AutomationProperties.Name="Evaluate suitable models automatically" loc:Loc.ItName="Valuta automaticamente i modelli adatti"
                                          AutomationProperties.AccessibilityView="Control"
                                          Toggled="DiscoveryPolicyAutoEvaluateToggle_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXDividerStyle}" Margin="0,4,0,4" />

                        <!-- Row 2: Promotion policy -->
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DiscoveryPolicyPromotionLabel"
                                           Text="Promotion policy" loc:Loc.ItText="Criterio di promozione"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock x:Name="DiscoveryPolicyPromotionExplanation"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="Settings_DiscoveryPolicy_Promotion_ComboBox"
                                      Grid.Column="1"
                                      MinWidth="200"
                                      MaxWidth="260"
                                      AutomationProperties.AutomationId="Settings_DiscoveryPolicy_Promotion_ComboBox"
                                      AutomationProperties.Name="Promotion policy" loc:Loc.ItName="Criterio di promozione"
                                      AutomationProperties.AccessibilityView="Control"
                                      SelectionChanged="DiscoveryPolicyPromotionComboBox_SelectionChanged">
                                <ComboBoxItem Content="Ask before replacing" loc:Loc.ItContent="Chiedi prima di sostituire" Tag="ask" />
                                <ComboBoxItem Content="Auto-promote only when clearly better" loc:Loc.ItContent="Promuovi in automatico solo se chiaramente migliore" Tag="clearly_better" />
                                <ComboBoxItem Content="Never replace pinned or manual choices" loc:Loc.ItContent="Non sostituire mai le scelte fissate o manuali" Tag="never" />
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="Settings_DiscoveryPolicy_Status_Text"
                                   AutomationProperties.AutomationId="Settings_DiscoveryPolicy_Status_Text"
                                   AutomationProperties.Name="Candidate discovery policy status" loc:Loc.ItName="Stato dei criteri di scoperta dei candidati"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Automatic checks ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Models">
                <TextBlock Text="AUTOMATIC CHECKS" loc:Loc.ItText="CONTROLLI AUTOMATICI" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock Text="PaRuX periodically looks for new model candidates and suggests runtimes for this PC. Models are never downloaded without your approval. PaRuX-managed runtimes can update themselves safely (tested first, previous build kept for rollback). Checks pause while Gaming Mode is on." loc:Loc.ItText="PaRuX cerca periodicamente nuovi modelli candidati e suggerisce runtime per questo PC. I modelli non vengono mai scaricati senza la tua approvazione. I runtime gestiti da PaRuX possono aggiornarsi in sicurezza (prima testati, con la build precedente conservata per il ripristino). I controlli sono sospesi mentre la Modalità Gaming è attiva."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Check automatically" loc:Loc.ItText="Controlla automaticamente"
                                       Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <ToggleSwitch x:Name="Settings_AutoCheck_Enabled_Toggle"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="Settings_AutoCheck_Enabled_Toggle"
                                          AutomationProperties.Name="Check automatically" loc:Loc.ItName="Controlla automaticamente"
                                          Toggled="AutoCheckEnabledToggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Check every (hours, 1 to 720)" loc:Loc.ItText="Controlla ogni (ore, da 1 a 720)"
                                       Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <NumberBox x:Name="Settings_AutoCheck_Interval_Box"
                                       Grid.Column="1" Width="120" Minimum="1" Maximum="720" SmallChange="1" LargeChange="12"
                                       SpinButtonPlacementMode="Compact" Value="24"
                                       AutomationProperties.AutomationId="Settings_AutoCheck_Interval_Box"
                                       AutomationProperties.Name="Check interval in hours" loc:Loc.ItName="Intervallo di controllo in ore"
                                       ValueChanged="AutoCheckIntervalBox_ValueChanged" />
                        </Grid>
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Keep PaRuX-managed runtimes up to date automatically" loc:Loc.ItText="Mantieni aggiornati automaticamente i runtime gestiti da PaRuX"
                                       Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <ToggleSwitch x:Name="Settings_AutoCheck_RuntimeUpdate_Toggle"
                                          Grid.Column="1" IsOn="True"
                                          AutomationProperties.AutomationId="Settings_AutoCheck_RuntimeUpdate_Toggle"
                                          AutomationProperties.Name="Keep PaRuX-managed runtimes up to date automatically" loc:Loc.ItName="Mantieni aggiornati automaticamente i runtime gestiti da PaRuX"
                                          Toggled="AutoCheckRuntimeUpdateToggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource PaRuXSettingsRowStyle}" ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Optimize the media engine for this PC automatically when idle" loc:Loc.ItText="Ottimizza automaticamente il motore multimediale per questo PC quando è inattivo"
                                       Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                            <ToggleSwitch x:Name="Settings_AutoCheck_MediaOptimize_Toggle"
                                          Grid.Column="1" IsOn="True"
                                          AutomationProperties.AutomationId="Settings_AutoCheck_MediaOptimize_Toggle"
                                          AutomationProperties.Name="Optimize the media engine for this PC automatically when idle" loc:Loc.ItName="Ottimizza automaticamente il motore multimediale per questo PC quando è inattivo"
                                          Toggled="AutoCheckMediaOptimizeToggle_Toggled" />
                        </Grid>
                        <TextBlock x:Name="Settings_AutoCheck_Tuning_Explanation_Text"
                                   AutomationProperties.AutomationId="Settings_AutoCheck_Tuning_Explanation_Text"
                                   AutomationProperties.Name="What automatic tuning does" loc:Loc.ItName="Cosa fa la regolazione automatica"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                            <Button x:Name="Settings_AutoCheck_MediaOptimize_Button" Content="Optimize media engine for this PC" loc:Loc.ItContent="Ottimizza il motore multimediale per questo PC"
                                    AutomationProperties.AutomationId="Settings_AutoCheck_MediaOptimize_Button"
                                    Click="AutoCheckMediaOptimize_Click" />
                            <Button x:Name="Settings_AutoCheck_MediaOptimizeCancel_Button" Content="Cancel" loc:Loc.ItContent="Annulla" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="Settings_AutoCheck_MediaOptimizeCancel_Button"
                                    Click="AutoCheckMediaOptimizeCancel_Click" />
                        </StackPanel>
                        <TextBlock x:Name="Settings_AutoCheck_MediaOptimize_Text"
                                   AutomationProperties.AutomationId="Settings_AutoCheck_MediaOptimize_Text"
                                   AutomationProperties.Name="Media engine optimisation status" loc:Loc.ItName="Stato dell&#x27;ottimizzazione del motore multimediale"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                            <Button x:Name="Settings_AutoCheck_CheckNow_Button" Content="Check now" loc:Loc.ItContent="Controlla ora"
                                    AutomationProperties.AutomationId="Settings_AutoCheck_CheckNow_Button"
                                    Click="AutoCheckNow_Click" />
                            <Button x:Name="Settings_AutoCheck_RuntimeUpdate_Button" Content="Update runtimes now" loc:Loc.ItContent="Aggiorna i runtime ora"
                                    AutomationProperties.AutomationId="Settings_AutoCheck_RuntimeUpdate_Button"
                                    Click="AutoCheckRuntimeUpdateNow_Click" />
                        </StackPanel>
                        <TextBlock x:Name="Settings_AutoCheck_RuntimeUpdate_Text"
                                   AutomationProperties.AutomationId="Settings_AutoCheck_RuntimeUpdate_Text"
                                   AutomationProperties.Name="Last runtime update result" loc:Loc.ItName="Esito dell&#x27;ultimo aggiornamento dei runtime"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBlock x:Name="Settings_AutoCheck_LastRun_Text"
                                   AutomationProperties.AutomationId="Settings_AutoCheck_LastRun_Text"
                                   AutomationProperties.Name="Last automatic check" loc:Loc.ItName="Ultimo controllo automatico"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBlock x:Name="Settings_AutoCheck_Status_Text"
                                   AutomationProperties.AutomationId="Settings_AutoCheck_Status_Text"
                                   AutomationProperties.Name="Automatic checks status" loc:Loc.ItName="Stato dei controlli automatici"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Avatar Studio ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="AVATAR STUDIO" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Real local lip-synced talking-avatar video from a reference photo plus text - powered by LatentSync (Apache-2.0, chosen over Wav2Lip specifically because Wav2Lip's checkpoint is non-commercial-only). Install downloads the engine and its ~5 GB checkpoint once; still works with an external provider (e.g. Duix) configured instead, which takes priority if both are set up." loc:Loc.ItText="Vero video locale di avatar parlante con sincronia labiale a partire da una foto di riferimento più un testo, basato su LatentSync (Apache-2.0, scelto al posto di Wav2Lip proprio perché il checkpoint di Wav2Lip è solo non commerciale). L&#x27;installazione scarica una volta il motore e il suo checkpoint da circa 5 GB; funziona anche con un provider esterno (ad es. Duix) configurato al suo posto, che ha la priorità se sono configurati entrambi." />
                        <TextBlock x:Name="AvatarEngineStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" Text="Checking local avatar engine…" loc:Loc.ItText="Controllo del motore avatar locale…" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}">
                            <Button x:Name="AvatarInstallButton" Content="Install engine (~5 GB)" loc:Loc.ItContent="Installa il motore (~5 GB)" Click="AvatarInstall_Click" />
                            <Button x:Name="AvatarPhotoButton" Content="Set reference photo…" loc:Loc.ItContent="Imposta la foto di riferimento…" Click="AvatarPhoto_Click" />
                        </StackPanel>
                        <ProgressRing x:Name="AvatarInstallProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />

                        <TextBlock x:Name="AvatarStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" Text="Checking avatar provider…" loc:Loc.ItText="Controllo del provider avatar…" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="AvatarTextBox" Grid.Column="0" PlaceholderText="Text for the avatar to say…" loc:Loc.ItPlaceholder="Testo che l&#x27;avatar deve dire…" IsEnabled="False" />
                            <Button x:Name="AvatarGenerateButton" Grid.Column="1" Content="Generate" loc:Loc.ItContent="Genera" Click="AvatarGenerate_Click" IsEnabled="False" />
                        </Grid>
                        <ProgressRing x:Name="AvatarProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== 3D Studio ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Media Generation">
                <TextBlock Text="3D STUDIO" loc:Loc.ItText="STUDIO 3D" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Turns an image into a real, textured 3D relief model (.glb) - draft quality (one viewing angle's worth of real geometry via depth estimation, not a full 360° reconstruction), but works on any modern GPU. Install downloads a depth-estimation model on first use." loc:Loc.ItText="Trasforma un&#x27;immagine in un vero modello 3D a rilievo con texture (.glb): qualità bozza (la geometria reale di un solo punto di vista tramite stima della profondità, non una ricostruzione completa a 360°), ma funziona su qualsiasi GPU moderna. L&#x27;installazione scarica un modello di stima della profondità al primo utilizzo." />
                        <TextBlock x:Name="ThreedEngineStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" Text="Checking 3D engine…" loc:Loc.ItText="Controllo del motore 3D…" />
                        <Button x:Name="ThreedInstallButton" Content="Install engine" loc:Loc.ItContent="Installa il motore" Click="ThreedInstall_Click" HorizontalAlignment="Left" />
                        <ProgressRing x:Name="ThreedInstallProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="ThreedSourceImageText" Text="Pick a source image…" loc:Loc.ItText="Scegli un&#x27;immagine di origine…" Style="{StaticResource PaRuXBodyTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Pick image…" loc:Loc.ItContent="Scegli l&#x27;immagine…" Click="ThreedPickImage_Click" />
                        </Grid>
                        <Button x:Name="ThreedGenerateButton" Content="Generate 3D model" loc:Loc.ItContent="Genera il modello 3D" Click="ThreedGenerate_Click" HorizontalAlignment="Left" IsEnabled="False" />
                        <ProgressRing x:Name="ThreedGenerateProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Width="20" Height="20" />
                        <TextBlock x:Name="ThreedResultText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />

                        <WebView2 x:Name="ThreedViewer" Height="0" Visibility="Collapsed" />
                        <StackPanel x:Name="ThreedActionsPanel" Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}" Visibility="Collapsed">
                            <Button Content="Save .glb…" loc:Loc.ItContent="Salva .glb…" Click="ThreedSave_Click" />
                            <Button x:Name="ThreedOpenBlenderButton" Content="Open in Blender" loc:Loc.ItContent="Apri in Blender" Click="ThreedOpenBlender_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Training ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Automation">
                <TextBlock Text="TRAINING DATASET" loc:Loc.ItText="DATASET DI TRAINING" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}"
                            Text="Only replies you rated 👍 or explicitly saved as a training candidate (the flag icon under a reply) are ever included — nothing is added automatically. Exports as JSONL, deduplicated, with a 90/10 train/validation split. This prepares data; it does not run any training." loc:Loc.ItText="Vengono incluse solo le risposte valutate 👍 o salvate esplicitamente come candidate al training (l&#x27;icona bandiera sotto una risposta): nulla viene aggiunto in automatico. Esporta in JSONL, deduplicato, con una divisione 90/10 tra training e validazione. Prepara i dati; non esegue alcun training." />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Export training dataset (JSONL)" loc:Loc.ItText="Esporta il dataset di training (JSONL)" Style="{StaticResource PaRuXBodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Export…" loc:Loc.ItContent="Esporta…" Click="ExportTrainingDataset_Click" />
                        </Grid>
                        <TextBlock x:Name="TrainingExportStatus" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Training Lab ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Automation">
                <TextBlock Text="TRAINING LAB" loc:Loc.ItText="LABORATORIO DI TRAINING" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceM}">
                        <TextBlock x:Name="TrainingEngineStatusText" TextWrapping="Wrap" Style="{StaticResource PaRuXCaptionTextStyle}" Text="Checking training engine…" loc:Loc.ItText="Controllo del motore di training…" />
                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceS}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Train JSONL" loc:Loc.ItText="JSONL per il training" Style="{StaticResource PaRuXCaptionTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Pick file…" loc:Loc.ItContent="Scegli il file…" Click="TrainingPickJsonl_Click" />
                        </Grid>
                        <TextBlock x:Name="TrainingJsonlPathText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" Text="(export a training dataset above, or pick an existing .jsonl)" loc:Loc.ItText="(esporta qui sopra un dataset di training oppure scegli un .jsonl esistente)" />
                        <TextBox x:Name="TrainingBaseModelBox" PlaceholderText="Base model (Unsloth 4-bit HF id)" loc:Loc.ItPlaceholder="Modello base (ID HF Unsloth a 4 bit)" Text="unsloth/Qwen2.5-0.5B-Instruct-bnb-4bit" />
                        <Button x:Name="TrainingStartButton" Content="Start training" loc:Loc.ItContent="Avvia il training" Click="TrainingStart_Click" HorizontalAlignment="Left" IsEnabled="False" />
                        <ProgressBar x:Name="TrainingJobProgress" Visibility="Collapsed" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="TrainingJobStatusText" Style="{StaticResource PaRuXCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Advanced / diagnostics ==================== -->
            <StackPanel Spacing="{StaticResource PaRuXSpaceS}" Tag="Advanced">
                <TextBlock Text="ADVANCED" loc:Loc.ItText="AVANZATE" Style="{StaticResource PaRuXSectionHeaderTextStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource PaRuXCardStyle}">
                    <StackPanel Spacing="{StaticResource PaRuXSpaceL}">

                        <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Local AI diagnostics" loc:Loc.ItText="Diagnostica dell&#x27;IA locale" Style="{StaticResource PaRuXBodyStrongTextStyle}" />
                                <TextBlock
                                    Text="Live state of llama-server, refreshed every three seconds." loc:Loc.ItText="Stato in tempo reale di llama-server, aggiornato ogni tre secondi."
                                    Style="{StaticResource PaRuXCaptionTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" loc:Loc.ItContent="Aggiorna"
                                    VerticalAlignment="Center"
                                    Height="32"
                                    Padding="16,0,16,0"
                                    CornerRadius="{StaticResource PaRuXRadiusSmall}"
                                    Click="RefreshDiagnostics_Click" />
                        </Grid>

                        <Border Style="{StaticResource PaRuXInsetCardStyle}">
                            <Grid ColumnSpacing="{StaticResource PaRuXSpaceL}" RowSpacing="{StaticResource PaRuXSpaceM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="llama-server health" loc:Loc.ItText="Stato di llama-server"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceS}" VerticalAlignment="Center">
                                    <!-- Never a bare "checking…": the ring spins until the first
                                         answer lands, then a coloured dot states the verdict. -->
                                    <ProgressRing x:Name="DiagRing" Width="14" Height="14" IsActive="True"
                                                  Foreground="{ThemeResource PaRuXBrandBrush}"
                                                  VerticalAlignment="Center" />
                                    <Border x:Name="DiagHealthDot" Width="8" Height="8"
                                            Visibility="Collapsed"
                                            CornerRadius="{StaticResource PaRuXRadiusPill}"
                                            Background="{ThemeResource PaRuXTextTertiaryBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="DiagHealth" Text="checking…" loc:Loc.ItText="controllo…"
                                               Style="{StaticResource PaRuXBodyTextStyle}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Active profile" loc:Loc.ItText="Profilo attivo"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiagProfile" Text="—"
                                           Style="{StaticResource PaRuXBodyTextStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mode" loc:Loc.ItText="Modalità"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiagMode" Text="—"
                                           Style="{StaticResource PaRuXBodyTextStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Text profile setting" loc:Loc.ItText="Impostazione del profilo di testo"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiagTextProfile" Text="—"
                                           Style="{StaticResource PaRuXBodyTextStyle}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Gaming Mode" loc:Loc.ItText="Modalità Gaming"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DiagGame" Text="—"
                                           Style="{StaticResource PaRuXBodyTextStyle}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="GPU / VRAM"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DiagVram" Text="—"
                                           Style="{StaticResource PaRuXBodyTextStyle}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="System RAM" loc:Loc.ItText="RAM di sistema"
                                           Style="{StaticResource PaRuXCaptionTextStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DiagRam" Text="—"
                                           Style="{StaticResource PaRuXBodyTextStyle}" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="DiagEndpoint" Style="{StaticResource PaRuXMicroTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== About ==================== -->
            <Border Style="{StaticResource PaRuXCardStyle}" Tag="General">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource PaRuXSpaceL}">
                    <ContentControl
                        Width="40"
                        Height="40"
                        VerticalAlignment="Top"
                        ContentTemplate="{StaticResource PrxOrbitMarkTemplate}"
                        IsHitTestVisible="False" />
                    <StackPanel Spacing="{StaticResource PaRuXSpaceXS}" VerticalAlignment="Center">
                        <TextBlock Text="PaRuX AI &amp; Gaming OS" Style="{StaticResource PaRuXSubtitleTextStyle}" />
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource PaRuXCaptionTextStyle}" />
                        <TextBlock Text="A local-first assistant for your own machine. Phase 1." loc:Loc.ItText="Un assistente local-first per la tua macchina. Fase 1."
                                   Style="{StaticResource PaRuXCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
